pkgname=flo-agents
pkgver=0.1_git20261118
pkgrel=0
_commit=709825b
pkgdesc="Optional agent session CLI for Nexus 7 flo"
url="https://github.com/gianlucamazza/nexus7-flo-linux"
arch="noarch"
license="MIT"
depends="openssh-client-default curl"
checkdepends="python3"
source="flo-agents-$_commit.tar.gz"
builddir="$srcdir/flo-agents-$_commit"

check() {
	python3 tests/test_flo_agents.py
}

package() {
	install -Dm755 scripts/flo-agents "$pkgdir/usr/bin/flo-agents"
	install -Dm644 docs/flo-agents.md "$pkgdir/usr/share/doc/flo-agents/flo-agents.md"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/flo-agents/LICENSE"
}

