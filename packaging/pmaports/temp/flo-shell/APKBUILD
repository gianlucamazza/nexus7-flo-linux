# Local package for the Nexus 7 2013 (flo); source is a git archive of
# the published feat/agent-pr-integration branch at d9eb5cd.
pkgname=flo-shell
pkgver=0.1_git20261118
pkgrel=1
_commit=d9eb5cd
pkgdesc="GPU-drawn Quickshell touch shell for the Nexus 7 2013"
url="https://localhost/flo-shell"
arch="noarch"
license="MIT"
depends="quickshell hyprland greetd wvkbd brightnessctl xdg-desktop-portal-hyprland xdg-desktop-portal-gtk hyprpolkitagent gnome-settings-daemon"
source="flo-shell-$_commit.tar.gz"
builddir="$srcdir/flo-shell-$_commit"
options="!check"

build() {
	make PREFIX=/usr
}

package() {
	make install DESTDIR="$pkgdir" PREFIX=/usr
}
