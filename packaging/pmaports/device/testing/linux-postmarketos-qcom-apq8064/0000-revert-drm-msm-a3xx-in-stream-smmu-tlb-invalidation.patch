From: Gianluca Mazza <info@gianlucamazza.it>
Subject: [PATCH] Revert "drm/msm/a3xx: in-stream SMMU TLB invalidation" (local)

Local revert of a66d59b2a223 for flo testing. The command stream writes
the SMMU global TLB invalidate registers, which need SMMU_AHB_CLK; that
clock is off on flo while the GPU runs. Suspected cause of the r15 boot
hang (one boot). To be dropped once the clock handling is fixed.

Assisted-by: Claude:claude-opus-5-5
---
diff --git i/drivers/gpu/drm/msm/adreno/a3xx_gpu.c w/drivers/gpu/drm/msm/adreno/a3xx_gpu.c
index e1cf9ea..76e0403 100644
--- i/drivers/gpu/drm/msm/adreno/a3xx_gpu.c
+++ w/drivers/gpu/drm/msm/adreno/a3xx_gpu.c
@@ -7,9 +7,6 @@
  */
 
 #include "a3xx_gpu.h"
-#include "msm_mmu.h"
-
-#include <linux/sizes.h>
 
 #define A3XX_INT0_MASK \
 	(A3XX_INT0_RBBM_AHB_ERROR |        \
@@ -33,63 +30,11 @@ extern bool hang_debug;
 static void a3xx_dump(struct msm_gpu *gpu);
 static bool a3xx_idle(struct msm_gpu *gpu);
 
-#define A3XX_SMMU_GLOBAL_TLBIALL_OFFSET	0xFFF00
-
-/* If a GPU VA was unmapped since the last submit, the GPU may still hold
- * a stale translation for it (fence-signaled does not imply translation
- * dropped on a3xx); once the VA is recycled the stale translation can be
- * used again.  The v0 SMMU has no TLBSYNC/TLBSTATUS, so completion is
- * enforced with idle (+WAIT_FOR_ME on a320) and a prefetch-stalling nop
- * IB around the invalidate write, as downstream kgsl does.
- */
-static void
-a3xx_emit_pending_tlbi(struct msm_gpu *gpu, struct msm_gem_submit *submit)
-{
-	struct a3xx_gpu *a3xx_gpu = to_a3xx_gpu(to_adreno_gpu(gpu));
-	struct msm_ringbuffer *ring = submit->ring;
-	u64 regs_iova;
-	unsigned int units, u;
-
-	if (!msm_iommu_consume_pending_tlbi(to_msm_vm(submit->vm)->mmu,
-					    &regs_iova, &units))
-		return;
-
-	OUT_PKT3(ring, CP_WAIT_FOR_IDLE, 1);
-	OUT_RING(ring, 0x00000000);
-	OUT_PKT3(ring, CP_WAIT_FOR_ME, 1);
-	OUT_RING(ring, 0x00000000);
-
-	for (u = 0; u < units; u++) {
-		OUT_PKT3(ring, CP_MEM_WRITE, 2);
-		OUT_RING(ring, lower_32_bits(regs_iova + u * SZ_1M +
-					     A3XX_SMMU_GLOBAL_TLBIALL_OFFSET));
-		OUT_RING(ring, 0);
-	}
-
-	OUT_PKT3(ring, CP_WAIT_FOR_IDLE, 1);
-	OUT_RING(ring, 0x00000000);
-	OUT_PKT3(ring, CP_WAIT_FOR_ME, 1);
-	OUT_RING(ring, 0x00000000);
-
-	if (a3xx_gpu->tlbi_nop_iova) {
-		OUT_PKT3(ring, CP_INDIRECT_BUFFER_PFD, 2);
-		OUT_RING(ring, lower_32_bits(a3xx_gpu->tlbi_nop_iova));
-		OUT_RING(ring, 2);
-		OUT_PKT2(ring);
-	}
-
-	/* invalidate all CP-cached state blocks: */
-	OUT_PKT3(ring, CP_INVALIDATE_STATE, 1);
-	OUT_RING(ring, 0x7fff);
-}
-
 static void a3xx_submit(struct msm_gpu *gpu, struct msm_gem_submit *submit)
 {
 	struct msm_ringbuffer *ring = submit->ring;
 	unsigned int i;
 
-	a3xx_emit_pending_tlbi(gpu, submit);
-
 	for (i = 0; i < submit->nr_cmds; i++) {
 		switch (submit->cmd[i].type) {
 		case MSM_SUBMIT_CMD_IB_TARGET_BUF:
@@ -462,9 +407,6 @@ static void a3xx_destroy(struct msm_gpu *gpu)
 
 	DBG("%s", gpu->name);
 
-	if (a3xx_gpu->tlbi_nop_bo)
-		msm_gem_kernel_put(a3xx_gpu->tlbi_nop_bo, gpu->vm);
-
 	adreno_gpu_cleanup(adreno_gpu);
 
 	adreno_gpu_ocmem_cleanup(&a3xx_gpu->ocmem);
@@ -614,31 +556,6 @@ static u32 a3xx_get_rptr(struct msm_gpu *gpu, struct msm_ringbuffer *ring)
 	return ring->memptrs->rptr;
 }
 
-/* Allocate the nop IB used to stall CP prefetch around the in-stream
- * invalidate.  This is not fatal on failure: the invalidate is still
- * emitted, just without the prefetch stall.
- */
-static void a3xx_alloc_tlbi_nop(struct a3xx_gpu *a3xx_gpu)
-{
-	struct msm_gpu *gpu = &a3xx_gpu->base.base;
-	void *ptr;
-
-	ptr = msm_gem_kernel_new(gpu->dev, SZ_4K,
-			check_apriv(gpu, MSM_BO_WC | MSM_BO_GPU_READONLY),
-			gpu->vm, &a3xx_gpu->tlbi_nop_bo,
-			&a3xx_gpu->tlbi_nop_iova);
-	if (IS_ERR(ptr)) {
-		a3xx_gpu->tlbi_nop_bo = NULL;
-		a3xx_gpu->tlbi_nop_iova = 0;
-		DRM_DEV_ERROR(gpu->dev->dev,
-			      "a3xx: nop IB alloc failed, prefetch stall disabled\n");
-		return;
-	}
-
-	((u32 *)ptr)[0] = CP_TYPE3_PKT | (CP_NOP << 8);
-	((u32 *)ptr)[1] = CP_TYPE3_PKT | (CP_NOP << 8);
-}
-
 static struct msm_gpu *a3xx_gpu_init(struct drm_device *dev)
 {
 	struct a3xx_gpu *a3xx_gpu = NULL;
@@ -704,8 +621,6 @@ static struct msm_gpu *a3xx_gpu_init(struct drm_device *dev)
 	icc_set_bw(icc_path, 0, Bps_to_icc(gpu->fast_rate) * 8);
 	icc_set_bw(ocmem_icc_path, 0, Bps_to_icc(gpu->fast_rate) * 8);
 
-	a3xx_alloc_tlbi_nop(a3xx_gpu);
-
 	return gpu;
 
 fail:
diff --git i/drivers/gpu/drm/msm/adreno/a3xx_gpu.h w/drivers/gpu/drm/msm/adreno/a3xx_gpu.h
index aac1501..3d4ec9d 100644
--- i/drivers/gpu/drm/msm/adreno/a3xx_gpu.h
+++ w/drivers/gpu/drm/msm/adreno/a3xx_gpu.h
@@ -20,9 +20,6 @@ struct a3xx_gpu {
 
 	/* if OCMEM is used for GMEM: */
 	struct adreno_ocmem ocmem;
-
-	struct drm_gem_object *tlbi_nop_bo;
-	u64 tlbi_nop_iova;
 };
 #define to_a3xx_gpu(x) container_of(x, struct a3xx_gpu, base)
 
diff --git i/drivers/gpu/drm/msm/msm_iommu.c w/drivers/gpu/drm/msm/msm_iommu.c
index 73e24c8..897e42c 100644
--- i/drivers/gpu/drm/msm/msm_iommu.c
+++ w/drivers/gpu/drm/msm/msm_iommu.c
@@ -6,10 +6,7 @@
 
 #include <linux/adreno-smmu-priv.h>
 #include <linux/io-pgtable.h>
-#include <linux/iommu.h>
 #include <linux/kmemleak.h>
-#include <linux/of_address.h>
-#include <linux/sizes.h>
 #include "msm_drv.h"
 #include "msm_gpu_trace.h"
 #include "msm_mmu.h"
@@ -23,12 +20,6 @@ struct msm_iommu {
 	struct page *prr_page;
 
 	struct kmem_cache *pt_cache;
-
-	/* GPU-visible mapping of the GPU-embedded SMMU register blocks,
-	 * used to issue in-stream TLBIALL from the command stream: */
-	u64 regs_iova;
-	unsigned int regs_units;
-	atomic_t pending_tlbi;
 };
 
 #define to_msm_iommu(x) container_of(x, struct msm_iommu, base)
@@ -708,8 +699,6 @@ static int msm_iommu_unmap(struct msm_mmu *mmu, uint64_t iova, size_t len)
 {
 	struct msm_iommu *iommu = to_msm_iommu(mmu);
 
-	atomic_set(&iommu->pending_tlbi, 1);
-
 	if (iova & BIT_ULL(48))
 		iova |= GENMASK_ULL(63, 49);
 
@@ -785,98 +774,6 @@ struct msm_mmu *msm_iommu_disp_new(struct device *dev, unsigned long quirks)
 	return mmu;
 }
 
-/* Fixed GPU VA for the GPU-visible SMMU register window; must sit below
- * the gpuvm aperture, which starts at SZ_16M:
- */
-#define MSM_IOMMU_GPU_REGS_IOVA	0x00800000
-
-/* Map the GPU-embedded SMMU register blocks into the GPU address space so
- * the command stream can issue TLBIALL itself, ordered before any command
- * that might touch a recycled VA (mirroring the downstream kgsl setstate
- * register window).  Best effort: on failure regs_units stays 0 and the
- * in-stream invalidate is simply not used.
- */
-static void msm_iommu_map_gpu_regs(struct msm_iommu *iommu, struct device *dev)
-{
-	struct of_phandle_args args;
-	struct device_node *np0, *np1 = NULL;
-	struct resource r0, r1 = { };
-	u64 iova = MSM_IOMMU_GPU_REGS_IOVA;
-	size_t size;
-	int idx, ret;
-
-	if (of_parse_phandle_with_args(dev->of_node, "iommus", "#iommu-cells",
-				       0, &args))
-		return;
-	np0 = args.np;
-	if (!of_device_is_compatible(np0, "qcom,apq8064-iommu"))
-		goto out;
-
-	if (of_address_to_resource(np0, 0, &r0))
-		goto out;
-
-	/* The GPU lists every stream id; find the first *distinct* iommu node
-	 * (the second SMMU unit):
-	 */
-	for (idx = 1; idx < 64; idx++) {
-		struct device_node *np;
-
-		if (of_parse_phandle_with_args(dev->of_node, "iommus",
-					       "#iommu-cells", idx, &args))
-			break;
-		np = args.np;
-		if (np != np0) {
-			np1 = np;
-			break;
-		}
-		of_node_put(np);
-	}
-
-	if (np1 && of_address_to_resource(np1, 0, &r1)) {
-		of_node_put(np1);
-		np1 = NULL;
-	}
-
-	size = (np1 && r1.start == r0.end + 1) ? SZ_2M : SZ_1M;
-
-	ret = iommu_map(iommu->domain, iova, r0.start, size,
-			IOMMU_READ | IOMMU_WRITE, GFP_KERNEL);
-	if (ret) {
-		dev_warn(dev, "msm iommu: SMMU regs GPU-visible map failed: %d\n",
-			 ret);
-		goto out;
-	}
-
-	iommu->regs_iova = iova;
-	iommu->regs_units = size / SZ_1M;
-
-out:
-	of_node_put(np0);
-	if (np1)
-		of_node_put(np1);
-}
-
-/* Consume a pending in-stream TLB invalidate request: returns true (and
- * the GPU-visible SMMU register window) if an unmap happened since the
- * last submit and the register window was mapped successfully.
- */
-bool msm_iommu_consume_pending_tlbi(struct msm_mmu *mmu, u64 *regs_iova,
-				    unsigned int *regs_units)
-{
-	struct msm_iommu *iommu = to_msm_iommu(mmu);
-
-	if (!atomic_xchg(&iommu->pending_tlbi, 0))
-		return false;
-
-	if (!iommu->regs_units)
-		return false;
-
-	*regs_iova = iommu->regs_iova;
-	*regs_units = iommu->regs_units;
-
-	return true;
-}
-
 struct msm_mmu *msm_iommu_gpu_new(struct device *dev, struct msm_gpu *gpu, unsigned long quirks)
 {
 	struct adreno_smmu_priv *adreno_smmu = dev_get_drvdata(dev);
@@ -898,8 +795,6 @@ struct msm_mmu *msm_iommu_gpu_new(struct device *dev, struct msm_gpu *gpu, unsig
 	}
 	iommu_set_fault_handler(iommu->domain, msm_gpu_fault_handler, iommu);
 
-	msm_iommu_map_gpu_regs(iommu, dev);
-
 	/* Enable stall on iommu fault: */
 	if (adreno_smmu->set_stall)
 		adreno_smmu->set_stall(adreno_smmu->cookie, true);
diff --git i/drivers/gpu/drm/msm/msm_mmu.h w/drivers/gpu/drm/msm/msm_mmu.h
index 445a71d..8915662 100644
--- i/drivers/gpu/drm/msm/msm_mmu.h
+++ w/drivers/gpu/drm/msm/msm_mmu.h
@@ -92,7 +92,4 @@ int msm_iommu_pagetable_params(struct msm_mmu *mmu, phys_addr_t *ttbr,
 int msm_iommu_pagetable_walk(struct msm_mmu *mmu, unsigned long iova, uint64_t ptes[4]);
 struct iommu_domain_geometry *msm_iommu_get_geometry(struct msm_mmu *mmu);
 
-bool msm_iommu_consume_pending_tlbi(struct msm_mmu *mmu, u64 *regs_iova,
-				    unsigned int *regs_units);
-
 #endif /* __MSM_MMU_H__ */
