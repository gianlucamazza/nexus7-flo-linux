From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gianluca Mazza <info@gianlucamazza.it>
Date: Tue, 17 Nov 2026 11:34:01 +0100
Subject: [PATCH] mmc: mmci: defer DMA descriptors until their request becomes
 active

Only map scatterlists during pre_req. Configuring a shared channel and preparing an unsubmitted descriptor while another transfer runs lets terminate_all invalidate the next request. Keep mapped counts per mmc_data so post_req can unmap an earlier request after the next one has started. Cancellation now unmaps only its own request. Cover ownership and failure unwinds with a real DMAengine boundary and MMIO simulation.
---
 drivers/mmc/host/Kconfig         |   6 +-
 drivers/mmc/host/mmci-test.c     | 322 +++++++++++++++++++++++++++----
 drivers/mmc/host/mmci.c          | 124 ++++--------
 drivers/mmc/host/mmci.h          |   1 -
 drivers/mmc/host/mmci_qcom_dml.c |   1 -
 5 files changed, 327 insertions(+), 127 deletions(-)

diff --git a/drivers/mmc/host/Kconfig b/drivers/mmc/host/Kconfig
index 1060c4c57..8beb0a098 100644
--- a/drivers/mmc/host/Kconfig
+++ b/drivers/mmc/host/Kconfig
@@ -41,8 +41,10 @@ config MMC_ARMMMCI_KUNIT_TEST
 	select DMA_ENGINE
 	default KUNIT_ALL_TESTS
 	help
-	  Test that synchronous MMC commands cannot consume the DMA descriptor
-	  pre-mapped for a later asynchronous block request.
+	  Test streaming DMA mapping ownership across pipelined block requests,
+	  synchronous commands and cancellation. The tests use a recording
+	  DMAengine provider and simulated MMIO, without starting real hardware.
+	  Say N unless you are developing the MMCI DMA lifecycle.
 
 config MMC_QCOM_DML
 	bool "Qualcomm Data Mover for SD Card Controller"
