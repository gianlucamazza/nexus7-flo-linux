+
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	KUNIT_ASSERT_EQ(test, mmci_prep_data(ctx->host, &ctx->next, true), 0);
+	ctx->prep_error = true;
+	mmci_get_next_data(ctx->host, &ctx->next);
