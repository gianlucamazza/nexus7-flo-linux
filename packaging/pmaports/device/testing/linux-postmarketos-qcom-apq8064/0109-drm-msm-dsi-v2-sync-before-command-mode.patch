From ff85fc434e9c4f29eace1ca46d2b6a85a24f3bfd Mon Sep 17 00:00:00 2001
From: Gianluca Mazza <info@gianlucamazza.it>
Date: Tue, 17 Nov 2026 00:17:14 +0100
Subject: [PATCH] drm/msm/dsi: synchronize v2 video before enabling commands

Match the vendor v2 handover sequence: wait for video completion while CMD_MODE_EN is still clear, then enable the command engine and submit the transaction. Initialize completion before unmasking its IRQ and abort rather than submit unsynchronized DMA after a failed wait. Check runtime PM/link clocks and unwind failures, including 6G OPP votes.

Assisted-by: Codex (OpenAI)
---
 drivers/gpu/drm/msm/dsi/dsi_host.c | 56 ++++++++++++++++++++++++------
 1 file changed, 45 insertions(+), 11 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 2b4ec5365..636f1df68 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -1216,14 +1216,13 @@ static void dsi_set_tx_power_mode(int mode, struct msm_dsi_host *msm_host)
 	dsi_write(msm_host, REG_DSI_CMD_DMA_CTRL, data);
 }
 
-static void dsi_wait4video_done(struct msm_dsi_host *msm_host)
+static int dsi_wait4video_done(struct msm_dsi_host *msm_host)
 {
 	u32 ret = 0;
 	struct device *dev = &msm_host->pdev->dev;
 
-	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_VIDEO_DONE, 1);
-
 	reinit_completion(&msm_host->video_comp);
+	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_VIDEO_DONE, 1);
 
 	ret = wait_for_completion_timeout(&msm_host->video_comp,
 			msecs_to_jiffies(70));
@@ -1232,14 +1231,16 @@ static void dsi_wait4video_done(struct msm_dsi_host *msm_host)
 		DRM_DEV_ERROR(dev, "wait for video done timed out\n");
 
 	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_VIDEO_DONE, 0);
+	return ret ? 0 : -ETIMEDOUT;
 }
 
-static void dsi_wait4video_eng_busy(struct msm_dsi_host *msm_host)
+static int dsi_wait4video_eng_busy(struct msm_dsi_host *msm_host)
 {
 	u32 data;
+	int ret;
 
 	if (!(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO))
-		return;
+		return 0;
 
 	data = dsi_read(msm_host, REG_DSI_STATUS0);
 
@@ -1249,13 +1250,16 @@ static void dsi_wait4video_eng_busy(struct msm_dsi_host *msm_host)
 	 * data already, so no need to wait in those cases
 	 */
 	if (!(data & DSI_STATUS0_VIDEO_MODE_ENGINE_BUSY))
-		return;
+		return 0;
 
 	if (msm_host->power_on && msm_host->enabled) {
-		dsi_wait4video_done(msm_host);
+		ret = dsi_wait4video_done(msm_host);
+		if (ret)
+			return ret;
 		/* delay 4 ms to skip BLLP */
 		usleep_range(2000, 4000);
 	}
+	return 0;
 }
 
 int dsi_tx_buf_alloc_6g(struct msm_dsi_host *msm_host, int size)
@@ -1473,7 +1477,12 @@ static int dsi_cmd_dma_tx(struct msm_dsi_host *msm_host, int len)
 
 	reinit_completion(&msm_host->dma_comp);
 
-	dsi_wait4video_eng_busy(msm_host);
+	/* V2 synchronizes in xfer_prepare(), before enabling command mode. */
+	if (cfg_hnd->major != MSM_DSI_VER_MAJOR_V2) {
+		ret = dsi_wait4video_eng_busy(msm_host);
+		if (ret)
+			return ret;
+	}
 
 	triggered = msm_dsi_manager_cmd_xfer_trigger(
 						msm_host->id, dma_base, len);
@@ -2181,6 +2190,7 @@ int msm_dsi_host_xfer_prepare(struct mipi_dsi_host *host,
 {
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
 	const struct msm_dsi_cfg_handler *cfg_hnd = msm_host->cfg_hnd;
+	int ret;
 
 	/* TODO: make sure dsi_cmd_mdp is idle.
 	 * Since DSI6G v1.2.0, we can set DSI_TRIG_CTRL.BLOCK_DMA_WITHIN_FRAME
@@ -2192,9 +2202,22 @@ int msm_dsi_host_xfer_prepare(struct mipi_dsi_host *host,
 	 * mdss interrupt is generated in mdp core clock domain
 	 * mdp clock need to be enabled to receive dsi interrupt
 	 */
-	pm_runtime_get_sync(&msm_host->pdev->dev);
-	cfg_hnd->ops->link_clk_set_rate(msm_host);
-	cfg_hnd->ops->link_clk_enable(msm_host);
+	ret = pm_runtime_resume_and_get(&msm_host->pdev->dev);
+	if (ret < 0)
+		return ret;
+	ret = cfg_hnd->ops->link_clk_set_rate(msm_host);
+	if (ret)
+		goto drop_opp_vote;
+	ret = cfg_hnd->ops->link_clk_enable(msm_host);
+	if (ret)
+		goto drop_opp_vote;
+
+	/* Match the v2 video/command handover: wait before CMD_MODE_EN. */
+	if (cfg_hnd->major == MSM_DSI_VER_MAJOR_V2) {
+		ret = dsi_wait4video_eng_busy(msm_host);
+		if (ret)
+			goto disable_link_clks;
+	}
 
 	/* TODO: vote for bus bandwidth */
 
@@ -2209,6 +2232,17 @@ int msm_dsi_host_xfer_prepare(struct mipi_dsi_host *host,
 	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_CMD_DMA_DONE, 1);
 
 	return 0;
+
+disable_link_clks:
+	cfg_hnd->ops->link_clk_disable(msm_host);
+	goto put_pm;
+drop_opp_vote:
+	/* 6G may have raised its performance vote before a clock failure. */
+	if (cfg_hnd->major == MSM_DSI_VER_MAJOR_6G)
+		dev_pm_opp_set_rate(&msm_host->pdev->dev, 0);
+put_pm:
+	pm_runtime_put(&msm_host->pdev->dev);
+	return ret;
 }
 
 void msm_dsi_host_xfer_restore(struct mipi_dsi_host *host,
-- 
2.56.0

