From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gianluca Mazza <info@gianlucamazza.it>
Date: Tue, 17 Nov 2026 12:02:31 +0100
Subject: [PATCH] clk: qcom: rcg: determine floor rates consistently for SDCC

Select the floor table entry during rate determination and calculate propagated parent rates from that selected frequency. Saturate below the hardware minimum for the MMCI probe, reject missing tables, and preserve normal/dynamic ceiling policies. Use the floor policy for all MSM8960 SDCC sources. Test rounding, programming and recalculation through CCF and a controlled regmap.
---
 drivers/clk/qcom/Kconfig                    |  10 ++
 drivers/clk/qcom/Makefile                   |   1 +
 drivers/clk/qcom/clk-rcg-test.c             | 182 ++++++++++++++++++++
 drivers/clk/qcom/clk-rcg.c                  |  32 +++-
 drivers/clk/qcom/gcc-msm8960.c              |  10 +-
 tools/testing/kunit/configs/mmci-rcg.config |  10 ++
 6 files changed, 234 insertions(+), 11 deletions(-)
 create mode 100644 drivers/clk/qcom/clk-rcg-test.c
 create mode 100644 tools/testing/kunit/configs/mmci-rcg.config

diff --git a/drivers/clk/qcom/Kconfig b/drivers/clk/qcom/Kconfig
index 7d84c2f1d..e24313556 100644
--- a/drivers/clk/qcom/Kconfig
+++ b/drivers/clk/qcom/Kconfig
@@ -19,6 +19,16 @@ menuconfig COMMON_CLK_QCOM
 
 if COMMON_CLK_QCOM
 
+config QCOM_RCG_KUNIT_TEST
+	tristate "KUnit tests for Qualcomm RCG rate selection" if !KUNIT_ALL_TESTS
+	depends on KUNIT
+	default KUNIT_ALL_TESTS
+	help
+	  Test legacy Qualcomm root clock generators through common clock
+	  framework rounding, programming and recalculation with a controlled
+	  regmap. Exercise floor and ceiling policies, minimum supported rates
+	  and parent propagation without requiring Qualcomm hardware.
+
 config CLK_ELIZA_DISPCC
 	tristate "Eliza Display Clock Controller"
 	depends on ARM64 || COMPILE_TEST
diff --git a/drivers/clk/qcom/Makefile b/drivers/clk/qcom/Makefile
index 58f9a5eb6..e36b03802 100644
--- a/drivers/clk/qcom/Makefile
+++ b/drivers/clk/qcom/Makefile
@@ -1,5 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0
 obj-$(CONFIG_COMMON_CLK_QCOM) += clk-qcom.o
+obj-$(CONFIG_QCOM_RCG_KUNIT_TEST) += clk-rcg-test.o
 
 clk-qcom-y += common.o
