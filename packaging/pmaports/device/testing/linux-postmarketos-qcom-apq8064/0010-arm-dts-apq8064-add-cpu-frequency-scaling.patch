+			opp-supported-hw = <0x4001>;
+		};
+
+		opp-918000000 {
+			opp-hz = /bits/ 64 <918000000>;
+			opp-microvolt-speed0-pvs0-v0 = <1100000>;
+			opp-microvolt-speed0-pvs1-v0 = <1050000>;
+			opp-microvolt-speed0-pvs3-v0 = <1000000>;
+			opp-microvolt-speed0-pvs4-v0 = <975000>;
+			opp-microvolt-speed14-pvs0-v0 = <1025000>;
+			opp-microvolt-speed14-pvs1-v0 = <1000000>;
+			opp-microvolt-speed14-pvs2-v0 = <950000>;
+			opp-microvolt-speed14-pvs3-v0 = <925000>;
+			opp-microvolt-speed14-pvs4-v0 = <900000>;
+			opp-microvolt-speed14-pvs5-v0 = <900000>;
+			opp-microvolt-speed14-pvs6-v0 = <900000>;
+			opp-supported-hw = <0x4001>;
+		};
+
+		opp-1026000000 {
+			opp-hz = /bits/ 64 <1026000000>;
+			opp-microvolt-speed0-pvs0-v0 = <1125000>;
+			opp-microvolt-speed0-pvs1-v0 = <1075000>;
+			opp-microvolt-speed0-pvs3-v0 = <1025000>;
+			opp-microvolt-speed0-pvs4-v0 = <1000000>;
+			opp-microvolt-speed14-pvs0-v0 = <1037500>;
+			opp-microvolt-speed14-pvs1-v0 = <1012500>;
+			opp-microvolt-speed14-pvs2-v0 = <975000>;
+			opp-microvolt-speed14-pvs3-v0 = <950000>;
+			opp-microvolt-speed14-pvs4-v0 = <925000>;
+			opp-microvolt-speed14-pvs5-v0 = <925000>;
+			opp-microvolt-speed14-pvs6-v0 = <925000>;
+			opp-supported-hw = <0x4001>;
+		};
+
+		opp-1134000000 {
+			opp-hz = /bits/ 64 <1134000000>;
+			opp-microvolt-speed0-pvs0-v0 = <1175000>;
+			opp-microvolt-speed0-pvs1-v0 = <1125000>;
+			opp-microvolt-speed0-pvs3-v0 = <1075000>;
+			opp-microvolt-speed0-pvs4-v0 = <1050000>;
+			opp-microvolt-speed14-pvs0-v0 = <1075000>;
+			opp-microvolt-speed14-pvs1-v0 = <1037500>;
+			opp-microvolt-speed14-pvs2-v0 = <1000000>;
+			opp-microvolt-speed14-pvs3-v0 = <975000>;
+			opp-microvolt-speed14-pvs4-v0 = <950000>;
+			opp-microvolt-speed14-pvs5-v0 = <937500>;
+			opp-microvolt-speed14-pvs6-v0 = <937500>;
+			opp-supported-hw = <0x4001>;
+		};
+
+		opp-1242000000 {
+			opp-hz = /bits/ 64 <1242000000>;
+			opp-microvolt-speed0-pvs0-v0 = <1200000>;
+			opp-microvolt-speed0-pvs1-v0 = <1150000>;
+			opp-microvolt-speed0-pvs3-v0 = <1100000>;
+			opp-microvolt-speed0-pvs4-v0 = <1075000>;
+			opp-microvolt-speed14-pvs0-v0 = <1087500>;
+			opp-microvolt-speed14-pvs1-v0 = <1050000>;
+			opp-microvolt-speed14-pvs2-v0 = <1012500>;
+			opp-microvolt-speed14-pvs3-v0 = <987500>;
+			opp-microvolt-speed14-pvs4-v0 = <962500>;
+			opp-microvolt-speed14-pvs5-v0 = <950000>;
+			opp-microvolt-speed14-pvs6-v0 = <950000>;
+			opp-supported-hw = <0x4001>;
+		};
+
+		opp-1350000000 {
+			opp-hz = /bits/ 64 <1350000000>;
+			opp-microvolt-speed0-pvs0-v0 = <1225000>;
+			opp-microvolt-speed0-pvs1-v0 = <1175000>;
+			opp-microvolt-speed0-pvs3-v0 = <1125000>;
+			opp-microvolt-speed0-pvs4-v0 = <1100000>;
+			opp-microvolt-speed14-pvs0-v0 = <1125000>;
+			opp-microvolt-speed14-pvs1-v0 = <1087500>;
+			opp-microvolt-speed14-pvs2-v0 = <1037500>;
+			opp-microvolt-speed14-pvs3-v0 = <1000000>;
+			opp-microvolt-speed14-pvs4-v0 = <975000>;
+			opp-microvolt-speed14-pvs5-v0 = <962500>;
+			opp-microvolt-speed14-pvs6-v0 = <962500>;
+			opp-supported-hw = <0x4001>;
+		};
+
+		opp-1458000000 {
+			opp-hz = /bits/ 64 <1458000000>;
+			opp-microvolt-speed0-pvs0-v0 = <1237500>;
+			opp-microvolt-speed0-pvs1-v0 = <1187500>;
+			opp-microvolt-speed0-pvs3-v0 = <1137500>;
+			opp-microvolt-speed0-pvs4-v0 = <1112500>;
+			opp-microvolt-speed14-pvs0-v0 = <1150000>;
+			opp-microvolt-speed14-pvs1-v0 = <1112500>;
+			opp-microvolt-speed14-pvs2-v0 = <1075000>;
+			opp-microvolt-speed14-pvs3-v0 = <1037500>;
+			opp-microvolt-speed14-pvs4-v0 = <1000000>;
+			opp-microvolt-speed14-pvs5-v0 = <987500>;
+			opp-microvolt-speed14-pvs6-v0 = <975000>;
+			opp-supported-hw = <0x4001>;
+		};
+
+		opp-1512000000 {
+			opp-hz = /bits/ 64 <1512000000>;
+			opp-microvolt-speed0-pvs0-v0 = <1250000>;
+			opp-microvolt-speed0-pvs1-v0 = <1200000>;
+			opp-microvolt-speed0-pvs3-v0 = <1150000>;
+			opp-microvolt-speed0-pvs4-v0 = <1125000>;
+			opp-microvolt-speed14-pvs0-v0 = <1162500>;
+			opp-microvolt-speed14-pvs1-v0 = <1125000>;
+			opp-microvolt-speed14-pvs2-v0 = <1087500>;
+			opp-microvolt-speed14-pvs3-v0 = <1050000>;
+			opp-microvolt-speed14-pvs4-v0 = <1012500>;
+			opp-microvolt-speed14-pvs5-v0 = <1000000>;
+			opp-microvolt-speed14-pvs6-v0 = <987500>;
+			opp-supported-hw = <0x4001>;
+		};
+	};
+
+	kraitcc: clock-controller {
+		compatible = "qcom,krait-cc-v1";
+		clocks = <&gcc PLL9>, <&gcc PLL10>, <&gcc PLL16>, <&gcc PLL17>,
+			 <&gcc PLL12>,
+			 <&acc0>, <&acc1>, <&acc2>, <&acc3>,
+			 <&l2cc>,
+			 <&pxo_board>;
+		clock-names = "hfpll0", "hfpll1", "hfpll2", "hfpll3",
+			      "hfpll_l2",
+			      "acpu0_aux", "acpu1_aux", "acpu2_aux", "acpu3_aux",
+			      "acpu_l2_aux",
+			      "qsb";
+		#clock-cells = <1>;
+	};
+
 	memory@0 {
 		device_type = "memory";
 		reg = <0x0 0x0>;
@@ -704,6 +933,10 @@
 			#address-cells = <1>;
 			#size-cells = <1>;
 
+			pvs_efuse: pvs@c0 {
+				reg = <0xc0 0x4>;
+			};
+
 			tsens_calib: calib@404 {
 				reg = <0x404 0x10>;
 			};
