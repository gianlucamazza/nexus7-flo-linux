From f17e4ce827fcea74885bc1050174036e3ab82072 Mon Sep 17 00:00:00 2001
From: bingoofsweden <bingoofsweden@users.noreply.github.com>
Date: Fri, 9 Oct 2026 16:15:44 +0200
Subject: [PATCH] thermal/drivers/qcom/tsens-8960: Fix status clear bits on
 APQ8064

On APQ8064 the cpu0 thermal zone (tsens sensor 7) stops updating and
keeps reporting its last reading as soon as the thermal core reprograms
the trip thresholds. Sensor 6 is switched off at the same time.

The regfields for LOW_INT_CLEAR_0 and UP_INT_CLEAR_0 point at CNTL bits
9 and 10. That matches MSM8960, which has 5 sensors with their enable
bits in CNTL[7:3]. APQ8064 has 11 sensors whose enable bits occupy
CNTL[13:3], as enable_8960() already assumes, so bits 9 and 10 are the
enable bits of sensors 6 and 7 there. The status clear bits live in
STATUS_CNTL (0x3660), bits 1 and 2.

tsens_set_trips() enables the upper and lower interrupts by writing 0
to those two fields, which on APQ8064 clears the enable bits of sensors
6 and 7. The sensors only come back if enable_8960() happens to run
afterwards, so whether a zone is frozen right after boot depends on
probe ordering. Once a zone crosses a trip point it is always frozen.

The downstream driver (drivers/thermal/msm8960_tsens.c) confirms the
layout: TSENS_8064_SENSOR6_EN is BIT(9), TSENS_8064_SENSOR7_EN is
BIT(10), and for APQ_8064 the status clear bits are taken from
TSENS_8064_STATUS_CNTL at 0x3660 with tsens_status_cntl_start = 0.

Use STATUS_CNTL[2:1] for the two clear fields when running on APQ8064.

Tested on a Samsung Galaxy S4 (samsung,jflte). With four cores loaded
for 45 s, cpu0 went 46 -> 72 degC while cpu3 crossed the 75 degC trip
several times, and fell back to 49 degC after 30 s idle. Before the
change cpu0 stayed at exactly 70000 through load and idle alike.

Signed-off-by: bingoofsweden <bingoofsweden@users.noreply.github.com>
---
 drivers/thermal/qcom/tsens-8960.c | 26 ++++++++++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/drivers/thermal/qcom/tsens-8960.c b/drivers/thermal/qcom/tsens-8960.c
index 4585904fb38002..11294b74aa21eb 100644
--- a/drivers/thermal/qcom/tsens-8960.c
+++ b/drivers/thermal/qcom/tsens-8960.c
@@ -6,6 +6,7 @@
 #include <linux/platform_device.h>
 #include <linux/delay.h>
 #include <linux/bitops.h>
+#include <linux/of.h>
 #include <linux/regmap.h>
 #include <linux/thermal.h>
 #include "tsens.h"
@@ -32,6 +33,8 @@
 #define THRESHOLD_ADDR		0x3624
 
 #define INT_STATUS_ADDR		0x363c
+/* APQ8064: upper/lower status clear bits live here, not in CNTL */
+#define STATUS_CNTL_ADDR_8064	0x3660
 
 #define S0_STATUS_OFF		0x3628
 #define S1_STATUS_OFF		0x362c
@@ -199,7 +202,7 @@ static int calibrate_8960(struct tsens_priv *priv)
 	return 0;
 }
 
-static const struct reg_field tsens_8960_regfields[MAX_REGFIELDS] = {
+static struct reg_field tsens_8960_regfields[MAX_REGFIELDS] = {
 	/* ----- SROT ------ */
 	/* No VERSION information */
 
@@ -256,8 +259,27 @@ static const struct reg_field tsens_8960_regfields[MAX_REGFIELDS] = {
 	[TRDY] = REG_FIELD(INT_STATUS_ADDR, 7, 7),
 };
 
+/*
+ * APQ8064 has 11 sensors, whose enable bits occupy CNTL[13:3]. The upper and
+ * lower status clear bits that MSM8960 keeps in CNTL[10:9] therefore moved to
+ * STATUS_CNTL[2:1]. Using the MSM8960 layout on APQ8064 makes every
+ * tsens_set_trips() call clear the enable bits of sensors 6 and 7, freezing
+ * their readings at the last value.
+ */
+static int init_8960(struct tsens_priv *priv)
+{
+	if (of_machine_is_compatible("qcom,apq8064")) {
+		tsens_8960_regfields[LOW_INT_CLEAR_0] =
+			(struct reg_field)REG_FIELD(STATUS_CNTL_ADDR_8064, 1, 1);
+		tsens_8960_regfields[UP_INT_CLEAR_0] =
+			(struct reg_field)REG_FIELD(STATUS_CNTL_ADDR_8064, 2, 2);
+	}
+
+	return init_common(priv);
+}
+
 static const struct tsens_ops ops_8960 = {
-	.init		= init_common,
+	.init		= init_8960,
 	.calibrate	= calibrate_8960,
 	.get_temp	= get_temp_common,
 	.enable		= enable_8960,
