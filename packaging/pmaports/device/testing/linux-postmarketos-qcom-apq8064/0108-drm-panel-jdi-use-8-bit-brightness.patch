From 51ad273c237f42c5ee4713c26622183b0f224c61 Mon Sep 17 00:00:00 2001
From: Gianluca Mazza <info@gianlucamazza.it>
Date: Mon, 16 Nov 2026 23:57:27 +0100
Subject: [PATCH] drm/panel: jdi-lt070me05000: use 8-bit brightness transfers

Match the native panel command with DCS short write 0x51 plus one level byte, and read the single-byte 0x52 response. Restore mode flags after failed transfers too. Cover init, update, read and error behavior through actual MIPI helpers with a recording KUnit host.

Assisted-by: Codex (OpenAI)
---
 drivers/gpu/drm/panel/Kconfig                 |   9 ++
 .../drm/panel/panel-jdi-lt070me05000-test.c   | 120 ++++++++++++++++++
 .../gpu/drm/panel/panel-jdi-lt070me05000.c    |  36 +++---
 .../kunit/configs/jdi_lt070me05000.config     |   9 ++
 4 files changed, 159 insertions(+), 15 deletions(-)
 create mode 100644 drivers/gpu/drm/panel/panel-jdi-lt070me05000-test.c
 create mode 100644 tools/testing/kunit/configs/jdi_lt070me05000.config

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index aa1c5db31..0a9bb35c9 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -393,6 +393,15 @@ config DRM_PANEL_JDI_LT070ME05000
 	  The panel has a 1200(RGB)×1920 (WUXGA) resolution and uses
 	  24 bit per pixel.
 
+config DRM_PANEL_JDI_LT070ME05000_KUNIT_TEST
+	bool "Test JDI LT070ME05000 brightness protocol" if !KUNIT_ALL_TESTS
+	depends on DRM=y && KUNIT=y && OF && BACKLIGHT_CLASS_DEVICE=y
+	select DRM_MIPI_DSI
+	select DRM_PANEL_JDI_LT070ME05000
+	default KUNIT_ALL_TESTS
+	help
+	  Exercise the panel backlight callbacks through a test MIPI DSI host.
+
 config DRM_PANEL_JDI_R63452
 	tristate "JDI R63452 Full HD DSI panel"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/panel-jdi-lt070me05000-test.c b/drivers/gpu/drm/panel/panel-jdi-lt070me05000-test.c
new file mode 100644
index 000000000..3e32837f9
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-jdi-lt070me05000-test.c
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Exercise panel callbacks through the real MIPI DSI helpers. */
+#include <kunit/test.h>
+
+struct jdi_test_host {
+	struct mipi_dsi_host host;
+	u8 brightness_payload[4];
+	u8 brightness_type;
+	size_t brightness_len;
+	size_t read_len;
+	int error;
+};
+
+static ssize_t jdi_test_transfer(struct mipi_dsi_host *host,
+				 const struct mipi_dsi_msg *msg)
+{
+	struct jdi_test_host *fake = container_of(host, struct jdi_test_host, host);
+
+	if (fake->error)
+		return fake->error;
+	if (msg->rx_len) {
+		fake->read_len = msg->rx_len;
+		((u8 *)msg->rx_buf)[0] = 77;
+		return 1;
+	}
+	if (msg->tx_len && ((u8 *)msg->tx_buf)[0] == MIPI_DCS_SET_DISPLAY_BRIGHTNESS) {
+		fake->brightness_type = msg->type;
+		fake->brightness_len = msg->tx_len;
+		memcpy(fake->brightness_payload, msg->tx_buf,
+		       min(msg->tx_len, sizeof(fake->brightness_payload)));
+	}
+	return msg->tx_len;
+}
+
+static const struct mipi_dsi_host_ops jdi_test_ops = {
+	.transfer = jdi_test_transfer,
+};
+
+static void jdi_test_setup(struct jdi_test_host *host,
+			   struct mipi_dsi_device *dsi,
+			   struct backlight_device *backlight)
+{
+	memset(host, 0, sizeof(*host));
+	memset(dsi, 0, sizeof(*dsi));
+	memset(backlight, 0, sizeof(*backlight));
+	host->host.ops = &jdi_test_ops;
+	dsi->host = &host->host;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_LPM;
+	backlight->props.brightness = 127;
+	dev_set_drvdata(&backlight->dev, dsi);
+}
+
+static void jdi_test_brightness_short_write(struct kunit *test)
+{
+	struct jdi_test_host host;
+	struct mipi_dsi_device dsi;
+	struct backlight_device backlight;
+
+	jdi_test_setup(&host, &dsi, &backlight);
+	KUNIT_ASSERT_EQ(test, dsi_dcs_bl_update_status(&backlight), 0);
+	KUNIT_EXPECT_EQ(test, host.brightness_type, MIPI_DSI_DCS_SHORT_WRITE_PARAM);
+	KUNIT_EXPECT_EQ(test, host.brightness_len, (size_t)2);
+	KUNIT_EXPECT_EQ(test, host.brightness_payload[0], (u8)0x51);
+	KUNIT_EXPECT_EQ(test, host.brightness_payload[1], (u8)127);
+}
+
+static void jdi_test_brightness_single_byte_read(struct kunit *test)
+{
+	struct jdi_test_host host;
+	struct mipi_dsi_device dsi;
+	struct backlight_device backlight;
+
+	jdi_test_setup(&host, &dsi, &backlight);
+	KUNIT_EXPECT_EQ(test, dsi_dcs_bl_get_brightness(&backlight), 77);
+	KUNIT_EXPECT_EQ(test, host.read_len, (size_t)1);
+}
+
+static void jdi_test_restore_flags_after_error(struct kunit *test)
+{
+	struct jdi_test_host host;
+	struct mipi_dsi_device dsi;
+	struct backlight_device backlight;
+	unsigned long flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_LPM;
+
+	jdi_test_setup(&host, &dsi, &backlight);
+	host.error = -EIO;
+	KUNIT_EXPECT_EQ(test, dsi_dcs_bl_update_status(&backlight), -EIO);
+	KUNIT_EXPECT_EQ(test, dsi.mode_flags, flags);
+	dsi.mode_flags = flags;
+	KUNIT_EXPECT_EQ(test, dsi_dcs_bl_get_brightness(&backlight), -EIO);
+	KUNIT_EXPECT_EQ(test, dsi.mode_flags, flags);
+}
+
+static void jdi_test_initial_brightness_short_write(struct kunit *test)
+{
+	struct jdi_test_host host;
+	struct mipi_dsi_device dsi;
+	struct backlight_device backlight;
+	struct jdi_panel panel = { .dsi = &dsi, .backlight = &backlight,
+				   .mode = &default_mode };
+
+	jdi_test_setup(&host, &dsi, &backlight);
+	KUNIT_ASSERT_EQ(test, jdi_panel_init(&panel), 0);
+	KUNIT_EXPECT_EQ(test, host.brightness_type, MIPI_DSI_DCS_SHORT_WRITE_PARAM);
+	KUNIT_EXPECT_EQ(test, host.brightness_len, (size_t)2);
+}
+
+static struct kunit_case jdi_cases[] = {
+	KUNIT_CASE(jdi_test_brightness_short_write),
+	KUNIT_CASE(jdi_test_brightness_single_byte_read),
+	KUNIT_CASE(jdi_test_restore_flags_after_error),
+	KUNIT_CASE(jdi_test_initial_brightness_short_write),
+	{}
+};
+
+static struct kunit_suite jdi_suite = {
+	.name = "jdi-lt070me05000-backlight",
+	.test_cases = jdi_cases,
+};
+kunit_test_suite(jdi_suite);
diff --git a/drivers/gpu/drm/panel/panel-jdi-lt070me05000.c b/drivers/gpu/drm/panel/panel-jdi-lt070me05000.c
index c23b4f83e..e380d8a73 100644
--- a/drivers/gpu/drm/panel/panel-jdi-lt070me05000.c
+++ b/drivers/gpu/drm/panel/panel-jdi-lt070me05000.c
@@ -75,8 +75,8 @@ static int jdi_panel_init(struct jdi_panel *jdi)
 	 * backlight is still marked off here, so use the stored level.
 	 */
 	if (jdi->backlight)
-		mipi_dsi_dcs_set_display_brightness_multi(&dsi_ctx,
-				jdi->backlight->props.brightness);
+		mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+					     (u8)jdi->backlight->props.brightness);
 
 	/* CABC off */
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_POWER_SAVE, 0x00);
@@ -259,34 +259,36 @@ static int jdi_panel_get_modes(struct drm_panel *panel,
 static int dsi_dcs_bl_get_brightness(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	unsigned long mode_flags = dsi->mode_flags;
+	u8 brightness;
 	int ret;
-	u16 brightness = bl->props.brightness;
 
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-
-	ret = mipi_dsi_dcs_get_display_brightness(dsi, &brightness);
+	ret = mipi_dsi_dcs_read(dsi, MIPI_DCS_GET_DISPLAY_BRIGHTNESS,
+				&brightness, sizeof(brightness));
+	dsi->mode_flags = mode_flags;
 	if (ret < 0)
 		return ret;
+	if (ret != sizeof(brightness))
+		return -EIO;
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
-
-	return brightness & 0xff;
+	return brightness;
 }
 
 static int dsi_dcs_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	unsigned long mode_flags = dsi->mode_flags;
+	u8 brightness = bl->props.brightness;
 	int ret;
 
+	/* This panel implements an 8-bit DCS brightness register (0x51). */
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_write(dsi, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+				 &brightness, sizeof(brightness));
+	dsi->mode_flags = mode_flags;
 
-	ret = mipi_dsi_dcs_set_display_brightness(dsi, bl->props.brightness);
-	if (ret < 0)
-		return ret;
-
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
-
-	return 0;
+	return ret < 0 ? ret : 0;
 }
 
 static const struct backlight_ops dsi_bl_ops = {
@@ -433,3 +435,7 @@ MODULE_AUTHOR("Sumit Semwal <sumit.semwal@linaro.org>");
 MODULE_AUTHOR("Vinay Simha BN <simhavcs@gmail.com>");
 MODULE_DESCRIPTION("JDI LT070ME05000 WUXGA");
 MODULE_LICENSE("GPL v2");
+
+#if IS_ENABLED(CONFIG_DRM_PANEL_JDI_LT070ME05000_KUNIT_TEST)
+#include "panel-jdi-lt070me05000-test.c"
+#endif
