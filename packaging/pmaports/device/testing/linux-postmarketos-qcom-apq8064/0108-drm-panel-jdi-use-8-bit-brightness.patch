new file mode 100644
index 000000000..48781a963
--- /dev/null
+++ b/tools/testing/kunit/configs/jdi_lt070me05000.config
@@ -0,0 +1,9 @@
+CONFIG_KUNIT=y
+CONFIG_OF=y
+CONFIG_DRM=y
+CONFIG_DRM_MIPI_DSI=y
+CONFIG_DRM_PANEL=y
+CONFIG_BACKLIGHT_CLASS_DEVICE=y
+CONFIG_DRM_PANEL_JDI_LT070ME05000=y
+CONFIG_DRM_PANEL_JDI_LT070ME05000_KUNIT_TEST=y
+CONFIG_DRM_PANEL_SAMSUNG_MAGNA_OCTA=n
