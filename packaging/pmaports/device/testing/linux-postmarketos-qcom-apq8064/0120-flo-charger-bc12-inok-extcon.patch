+static int smb347_update_usb_source_locked(struct smb347_charger *smb)
+{
+	union power_supply_propval val;
+	enum power_supply_usb_type type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	unsigned int source_ua = 100000;
+	int ret;
