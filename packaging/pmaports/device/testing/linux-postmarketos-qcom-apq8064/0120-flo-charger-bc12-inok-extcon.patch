-	ret = regmap_write(regmap, args.args[0], args.args[1]);
-	if (ret)
-		return ret;
-
-	ci->secondary_phy = !!args.args[1];
-	if (ci->secondary_phy) {
-		val = readl_relaxed(ci->base + HS_PHY_SEC_CTRL);
-		val |= HS_PHY_DIG_CLAMP_N;
-		writel_relaxed(val, ci->base + HS_PHY_SEC_CTRL);
-	}
-
-	return 0;
-}
-
-static int ci_hdrc_msm_probe(struct platform_device *pdev)
-{
-	struct ci_hdrc_msm *ci;
-	struct platform_device *plat_ci;
-	struct clk *clk;
-	struct reset_control *reset;
-	int ret;
-	struct device_node *ulpi_node, *phy_node;
-
-	dev_dbg(&pdev->dev, "ci_hdrc_msm_probe\n");
-
-	ci = devm_kzalloc(&pdev->dev, sizeof(*ci), GFP_KERNEL);
-	if (!ci)
-		return -ENOMEM;
-	platform_set_drvdata(pdev, ci);
-
-	ci->pdata.name = "ci_hdrc_msm";
-	ci->pdata.capoffset = DEF_CAPOFFSET;
-	ci->pdata.flags	= CI_HDRC_REGS_SHARED | CI_HDRC_DISABLE_STREAMING |
-			  CI_HDRC_OVERRIDE_AHB_BURST |
-			  CI_HDRC_OVERRIDE_PHY_CONTROL;
-	ci->pdata.notify_event = ci_hdrc_msm_notify_event;
-
-	reset = devm_reset_control_get(&pdev->dev, "core");
-	if (IS_ERR(reset))
-		return PTR_ERR(reset);
-
-	ci->core_clk = clk = devm_clk_get(&pdev->dev, "core");
-	if (IS_ERR(clk))
-		return PTR_ERR(clk);
-
-	ci->iface_clk = clk = devm_clk_get(&pdev->dev, "iface");
-	if (IS_ERR(clk))
-		return PTR_ERR(clk);
-
-	ci->fs_clk = clk = devm_clk_get_optional(&pdev->dev, "fs");
-	if (IS_ERR(clk))
-		return PTR_ERR(clk);
-
-	ci->base = devm_platform_ioremap_resource(pdev, 1);
-	if (IS_ERR(ci->base))
-		return PTR_ERR(ci->base);
-
-	ci->rcdev.owner = THIS_MODULE;
-	ci->rcdev.ops = &ci_hdrc_msm_reset_ops;
-	ci->rcdev.of_node = pdev->dev.of_node;
-	ci->rcdev.nr_resets = 2;
-	ret = devm_reset_controller_register(&pdev->dev, &ci->rcdev);
-	if (ret)
-		return ret;
-
-	ret = clk_prepare_enable(ci->fs_clk);
-	if (ret)
-		return ret;
-
-	reset_control_assert(reset);
-	usleep_range(10000, 12000);
-	reset_control_deassert(reset);
-
-	clk_disable_unprepare(ci->fs_clk);
-
-	ret = clk_prepare_enable(ci->core_clk);
-	if (ret)
-		return ret;
-
-	ret = clk_prepare_enable(ci->iface_clk);
-	if (ret)
-		goto err_iface;
-
-	ret = ci_hdrc_msm_mux_phy(ci, pdev);
-	if (ret)
-		goto err_mux;
-
-	ulpi_node = of_get_child_by_name(pdev->dev.of_node, "ulpi");
-	if (ulpi_node) {
-		phy_node = of_get_next_available_child(ulpi_node, NULL);
-		ci->hsic = of_device_is_compatible(phy_node, "qcom,usb-hsic-phy");
-		of_node_put(phy_node);
-	}
-	of_node_put(ulpi_node);
-
-	plat_ci = ci_hdrc_add_device(&pdev->dev, pdev->resource,
-				     pdev->num_resources, &ci->pdata);
-	if (IS_ERR(plat_ci)) {
-		ret = PTR_ERR(plat_ci);
-		if (ret != -EPROBE_DEFER)
-			dev_err(&pdev->dev, "ci_hdrc_add_device failed!\n");
-		goto err_mux;
-	}
-
-	ci->ci = plat_ci;
-
-	pm_runtime_set_active(&pdev->dev);
-	pm_runtime_no_callbacks(&pdev->dev);
-	pm_runtime_enable(&pdev->dev);
-
-	return 0;
-
-err_mux:
-	clk_disable_unprepare(ci->iface_clk);
-err_iface:
-	clk_disable_unprepare(ci->core_clk);
-	return ret;
-}
-
-static void ci_hdrc_msm_remove(struct platform_device *pdev)
-{
-	struct ci_hdrc_msm *ci = platform_get_drvdata(pdev);
-
-	pm_runtime_disable(&pdev->dev);
-	ci_hdrc_remove_device(ci->ci);
-	clk_disable_unprepare(ci->iface_clk);
-	clk_disable_unprepare(ci->core_clk);
-}
-
-static const struct of_device_id msm_ci_dt_match[] = {
-	{ .compatible = "qcom,ci-hdrc", },
-	{ }
-};
-MODULE_DEVICE_TABLE(of, msm_ci_dt_match);
-
-static struct platform_driver ci_hdrc_msm_driver = {
-	.probe = ci_hdrc_msm_probe,
-	.remove = ci_hdrc_msm_remove,
-	.driver = {
-		.name = "msm_hsusb",
-		.of_match_table = msm_ci_dt_match,
-	},
-};
-
-module_platform_driver(ci_hdrc_msm_driver);
-
-MODULE_ALIAS("platform:msm_hsusb");
-MODULE_ALIAS("platform:ci13xxx_msm");
-MODULE_DESCRIPTION("ChipIdea Highspeed Dual Role Controller");
-MODULE_LICENSE("GPL v2");
diff --git a/drivers/usb/chipidea/ci_hdrc_msm_bc12.c b/drivers/usb/chipidea/ci_hdrc_msm_bc12.c
new file mode 100644
index 000000000..ad7000830
--- /dev/null
+++ b/drivers/usb/chipidea/ci_hdrc_msm_bc12.c
@@ -0,0 +1,211 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Battery Charging 1.2 detection on the APQ8064 Synopsys 28 nm PHY. */
+
+#include <linux/errno.h>
+#include <linux/bits.h>
+#include <linux/ulpi/regs.h>
+
+#include "ci_hdrc_msm_bc12.h"
+
+#define SNPS_CHG_CTRL_SET	0x85
+#define SNPS_CHG_CTRL_CLR	0x86
+#define SNPS_CHG_STATUS		0x87
+#define SNPS_ALT_INT_LATCH_CLR	0x92
+#define SNPS_ALT_INT_EN_CLR	0x95
+
+bool ci_msm_bc12_source_complete(struct ci_msm_bc12_source_state *source,
+				  bool vbus_active,
+				  enum ci_msm_bc12_type type)
+{
+	enum power_supply_usb_type usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	int current_max = 0;
+	bool changed;
+
+	if (vbus_active) {
+		current_max = 100000;
+		switch (type) {
+		case CI_MSM_BC12_SDP:
+			usb_type = POWER_SUPPLY_USB_TYPE_SDP;
+			break;
+		case CI_MSM_BC12_CDP:
+			usb_type = POWER_SUPPLY_USB_TYPE_CDP;
+			current_max = 1200000;
+			break;
+		case CI_MSM_BC12_DCP:
+			usb_type = POWER_SUPPLY_USB_TYPE_DCP;
+			current_max = 1200000;
+			break;
+		case CI_MSM_BC12_PROPRIETARY:
+			current_max = 1200000;
+			break;
+		default:
+			break;
+		}
+	}
+
+	changed = source->online != vbus_active ||
+		  source->usb_type != usb_type ||
+		  source->current_max != current_max;
+	source->online = vbus_active;
+	source->usb_type = usb_type;
+	source->current_max = current_max;
+	return changed;
+}
+
+bool ci_msm_bc12_source_needs_detection(
+	const struct ci_msm_bc12_source_state *source,
+	bool vbus_active, bool gadget_role)
+{
+	return vbus_active && gadget_role &&
+		(!source->online ||
+		 (source->usb_type == POWER_SUPPLY_USB_TYPE_UNKNOWN &&
+		  source->current_max <= 100000));
+}
+
+bool ci_msm_bc12_source_stop(struct ci_msm_bc12_source_state *source,
+			     bool vbus_active, bool gadget_role)
+{
+	if (vbus_active && gadget_role) {
+		if (source->online &&
+		    source->usb_type == POWER_SUPPLY_USB_TYPE_SDP &&
+		    source->current_max > 100000) {
+			source->current_max = 100000;
+			return true;
+		}
+		return false;
+	}
+	if (!source->online &&
+	    source->usb_type == POWER_SUPPLY_USB_TYPE_UNKNOWN &&
+	    !source->current_max)
+		return false;
+
+	source->online = false;
+	source->usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	source->current_max = 0;
+	return true;
+}
+
+static int bc12_clear(const struct ci_msm_bc12_io *io)
+{
+	int ret, first;
+
+	first = io->write(io->context, SNPS_CHG_CTRL_CLR, 0x3f);
+	ret = io->write(io->context, SNPS_ALT_INT_LATCH_CLR, 0x1f);
+	if (!first)
+		first = ret;
+	ret = io->write(io->context, SNPS_ALT_INT_EN_CLR, 0x1f);
+	if (!first)
+		first = ret;
+
+	return first;
+}
+
+int ci_msm_bc12_detect(const struct ci_msm_bc12_io *io,
+		       enum ci_msm_bc12_type *type)
+{
+	int func, otg, status, ret, cleanup;
+	unsigned int i;
+	bool primary;
+
+	*type = CI_MSM_BC12_UNKNOWN;
+	func = io->read(io->context, ULPI_FUNC_CTRL);
+	if (func < 0)
+		return func;
+	/* A PHY reset may clear SUSPENDM; keep ULPI active for detection. */
+	func |= ULPI_FUNC_CTRL_SUSPENDM;
+	otg = io->read(io->context, ULPI_OTG_CTRL);
+	if (otg < 0)
+		return otg;
+
+	ret = io->write(io->context, ULPI_FUNC_CTRL,
+			(func & ~ULPI_FUNC_CTRL_OPMODE_MASK) |
+			ULPI_FUNC_CTRL_OPMODE_NONDRIVING);
+	if (ret)
+		goto restore;
+	ret = io->write(io->context, ULPI_CLR(ULPI_OTG_CTRL),
+			ULPI_OTG_CTRL_DP_PULLDOWN | ULPI_OTG_CTRL_DM_PULLDOWN);
+	if (ret)
+		goto restore;
+	ret = bc12_clear(io);
+	if (ret)
+		goto restore;
+	io->wait_ms(io->context, 1);
+
+	ret = io->write(io->context, SNPS_CHG_CTRL_SET, 0x10);
+	if (ret)
+		goto restore;
+	for (i = 0; i < 15; i++) {
+		io->wait_ms(io->context, 50);
+		status = io->read(io->context, SNPS_CHG_STATUS);
+		if (status < 0) {
+			ret = status;
+			goto restore;
+		}
+		if (status & BIT(1))
+			break;
+	}
+	ret = io->write(io->context, SNPS_CHG_CTRL_CLR, 0x10);
+	if (ret)
+		goto restore;
+	ret = io->write(io->context, SNPS_CHG_CTRL_SET, 0x02);
+	if (ret)
+		goto restore;
+	ret = io->write(io->context, SNPS_CHG_CTRL_SET, 0x01);
+	if (ret)
+		goto restore;
+	io->wait_ms(io->context, 50);
+	status = io->read(io->context, SNPS_CHG_STATUS);
+	if (status < 0) {
+		ret = status;
+		goto restore;
+	}
+	primary = !!(status & BIT(0));
+	status = io->line_state(io->context);
+	if (status < 0) {
+		ret = status;
+		goto restore;
+	}
+	if (status) {
+		*type = CI_MSM_BC12_PROPRIETARY;
+		goto restore;
+	}
+	if (!primary) {
+		*type = CI_MSM_BC12_SDP;
+		goto restore;
+	}
+
+	ret = io->write(io->context, SNPS_CHG_CTRL_SET, 0x08);
+	if (ret)
+		goto restore;
+	ret = io->write(io->context, SNPS_CHG_CTRL_SET, 0x02);
+	if (ret)
+		goto restore;
+	ret = io->write(io->context, SNPS_CHG_CTRL_SET, 0x01);
+	if (ret)
+		goto restore;
+	io->wait_ms(io->context, 40);
+	status = io->read(io->context, SNPS_CHG_STATUS);
+	if (status < 0) {
+		ret = status;
+		goto restore;
+	}
+	*type = status & BIT(0) ? CI_MSM_BC12_DCP : CI_MSM_BC12_CDP;
+
+restore:
+	cleanup = bc12_clear(io);
+	if (!ret)
+		ret = cleanup;
+	cleanup = io->write(io->context, ULPI_OTG_CTRL, otg);
+	if (!ret)
+		ret = cleanup;
+	cleanup = io->write(io->context, ULPI_FUNC_CTRL, func);
+	if (!ret)
+		ret = cleanup;
+	if (ret)
+		*type = CI_MSM_BC12_UNKNOWN;
+	return ret;
+}
+
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12_KUNIT_TEST)
+#include "ci_hdrc_msm_bc12_test.c"
+#endif
diff --git a/drivers/usb/chipidea/ci_hdrc_msm_bc12.h b/drivers/usb/chipidea/ci_hdrc_msm_bc12.h
new file mode 100644
index 000000000..e831c9821
--- /dev/null
+++ b/drivers/usb/chipidea/ci_hdrc_msm_bc12.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __CI_HDRC_MSM_BC12_H
+#define __CI_HDRC_MSM_BC12_H
+
+#include <linux/types.h>
+#include <linux/power_supply.h>
+
+enum ci_msm_bc12_type {
+	CI_MSM_BC12_UNKNOWN,
+	CI_MSM_BC12_SDP,
+	CI_MSM_BC12_CDP,
+	CI_MSM_BC12_DCP,
+	CI_MSM_BC12_PROPRIETARY,
+};
+
+struct ci_msm_bc12_source_state {
+	bool online;
+	enum power_supply_usb_type usb_type;
+	int current_max;
+};
+
+bool ci_msm_bc12_source_complete(struct ci_msm_bc12_source_state *source,
+				  bool vbus_active,
+				  enum ci_msm_bc12_type type);
+bool ci_msm_bc12_source_needs_detection(
+	const struct ci_msm_bc12_source_state *source,
+	bool vbus_active, bool gadget_role);
+
+bool ci_msm_bc12_source_stop(struct ci_msm_bc12_source_state *source,
+			     bool vbus_active, bool gadget_role);
+
+struct ci_msm_bc12_io {
+	void *context;
+	int (*read)(void *context, u8 register_address);
+	int (*write)(void *context, u8 register_address, u8 value);
+	int (*line_state)(void *context);
+	void (*wait_ms)(void *context, unsigned int milliseconds);
+};
+
+int ci_msm_bc12_detect(const struct ci_msm_bc12_io *io,
+		       enum ci_msm_bc12_type *type);
+
+#endif
diff --git a/drivers/usb/chipidea/ci_hdrc_msm_bc12_test.c b/drivers/usb/chipidea/ci_hdrc_msm_bc12_test.c
new file mode 100644
index 000000000..e8e4fb1f5
--- /dev/null
+++ b/drivers/usb/chipidea/ci_hdrc_msm_bc12_test.c
@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <kunit/test.h>
+
+struct bc12_test_state {
+	u8 function_control;
+	u8 otg_control;
+	u8 phase;
+	bool dcd;
+	bool primary;
+	bool secondary;
+	bool proprietary;
+	bool failed;
+	bool primary_cleared;
+	bool phy_suspended;
+	unsigned int wait_total_ms;
+};
+
+static int bc12_test_read(void *context, u8 address)
+{
+	struct bc12_test_state *state = context;
+
+	if (address == 0x04)
+		return state->function_control;
+	if (address == 0x0a)
+		return state->otg_control;
+	if (address == 0x87) {
+		if (state->phase == 1)
+			return state->dcd ? BIT(1) : 0;
+		if (state->phase == 2)
+			return state->primary ? BIT(0) : 0;
+		if (state->phase == 3)
+			return state->secondary ? BIT(0) : 0;
+	}
+	return -EINVAL;
+}
+
+static int bc12_test_write(void *context, u8 address, u8 value)
+{
+	struct bc12_test_state *state = context;
+
+	if (state->phy_suspended)
+		return -ETIMEDOUT;
+	if (address == ULPI_FUNC_CTRL &&
+	    (value & ULPI_FUNC_CTRL_OPMODE_MASK) ==
+	    ULPI_FUNC_CTRL_OPMODE_NONDRIVING &&
+	    !(value & ULPI_FUNC_CTRL_SUSPENDM))
+		state->phy_suspended = true;
+
+	if (address == 0x86 && value == 0x3f)
+		state->primary_cleared = false;
+	if (address == 0x86 && value == 0x03)
+		state->primary_cleared = true;
+	/* The PHY must stay active between primary and secondary detection. */
+	if (address == 0x85 && value == 0x08 && state->primary_cleared)
+		return -ETIMEDOUT;
+
+	if (address == 0x85 && value == 0x10)
+		state->phase = 1;
+	else if (address == 0x85 && value == 0x02 && state->phase == 1)
+		state->phase = 2;
+	else if (address == 0x85 && value == 0x08)
+		state->phase = 3;
+	if (address == 0x04)
+		state->function_control = value;
+	if (address == 0x0a)
+		state->otg_control = value;
+	if (address == 0x85 && value == 0x01 && state->failed)
+		return -EIO;
+	return 0;
+}
+
+static void bc12_test_wait(void *context, unsigned int milliseconds)
+{
+	struct bc12_test_state *state = context;
+
+	state->wait_total_ms += milliseconds;
+}
+
+static int bc12_test_line_state(void *context)
+{
+	struct bc12_test_state *state = context;
+
+	return state->proprietary ? 1 : 0;
+}
+
+static void bc12_test_classification(struct kunit *test)
+{
+	struct bc12_test_state state = {
+		.function_control = 0x40,
+		.otg_control = 0x06,
+		.dcd = true,
+	};
+	struct ci_msm_bc12_io io = {
+		.context = &state,
+		.read = bc12_test_read,
+		.write = bc12_test_write,
+		.line_state = bc12_test_line_state,
+		.wait_ms = bc12_test_wait,
+	};
+	enum ci_msm_bc12_type type;
+	int ret;
+
+	ret = ci_msm_bc12_detect(&io, &type);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, type, CI_MSM_BC12_SDP);
+	KUNIT_EXPECT_EQ(test, state.function_control, (u8)0x40);
+	KUNIT_EXPECT_EQ(test, state.otg_control, (u8)0x06);
+
+	state.primary = true;
+	ret = ci_msm_bc12_detect(&io, &type);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, type, CI_MSM_BC12_CDP);
+
+	state.secondary = true;
+	ret = ci_msm_bc12_detect(&io, &type);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, type, CI_MSM_BC12_DCP);
+
+	state.proprietary = true;
+	ret = ci_msm_bc12_detect(&io, &type);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, type, CI_MSM_BC12_PROPRIETARY);
+
+	state.primary = false;
+	ret = ci_msm_bc12_detect(&io, &type);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, type, CI_MSM_BC12_PROPRIETARY);
+}
+
+static void bc12_test_error_restores_phy(struct kunit *test)
+{
+	struct bc12_test_state state = {
+		.function_control = 0x40,
+		.otg_control = 0x06,
+		.dcd = true,
+		.failed = true,
+	};
+	struct ci_msm_bc12_io io = {
+		.context = &state,
+		.read = bc12_test_read,
+		.write = bc12_test_write,
+		.line_state = bc12_test_line_state,
+		.wait_ms = bc12_test_wait,
+	};
+	enum ci_msm_bc12_type type = CI_MSM_BC12_DCP;
+
+	KUNIT_EXPECT_EQ(test, ci_msm_bc12_detect(&io, &type), -EIO);
+	KUNIT_EXPECT_EQ(test, type, CI_MSM_BC12_UNKNOWN);
+	KUNIT_EXPECT_EQ(test, state.function_control, (u8)0x40);
+	KUNIT_EXPECT_EQ(test, state.otg_control, (u8)0x06);
+}
+
+static void bc12_test_rebind_after_phy_reset(struct kunit *test)
+{
+	struct bc12_test_state state = {
+		.function_control = 0,
+		.otg_control = 0x07,
+		.dcd = true,
+		.primary = true,
+		.secondary = true,
+	};
+	struct ci_msm_bc12_io io = {
+		.context = &state,
+		.read = bc12_test_read,
+		.write = bc12_test_write,
+		.line_state = bc12_test_line_state,
+		.wait_ms = bc12_test_wait,
+	};
+	enum ci_msm_bc12_type type;
+
+	KUNIT_ASSERT_EQ(test, ci_msm_bc12_detect(&io, &type), 0);
+	KUNIT_EXPECT_EQ(test, type, CI_MSM_BC12_DCP);
+	KUNIT_EXPECT_TRUE(test, state.function_control &
+			  ULPI_FUNC_CTRL_SUSPENDM);
+}
+
+static void bc12_test_gadget_stop_keeps_live_source(struct kunit *test)
+{
+	struct ci_msm_bc12_source_state source = {
+		.online = true,
+		.usb_type = POWER_SUPPLY_USB_TYPE_DCP,
+		.current_max = 1200000,
+	};
+
+	KUNIT_EXPECT_FALSE(test, ci_msm_bc12_source_stop(&source, true, true));
+	KUNIT_EXPECT_TRUE(test, source.online);
+	KUNIT_EXPECT_EQ(test, source.usb_type, POWER_SUPPLY_USB_TYPE_DCP);
+	KUNIT_EXPECT_EQ(test, source.current_max, 1200000);
+}
+
+static void bc12_test_sdp_budget_drops_after_unbind(struct kunit *test)
+{
+	struct ci_msm_bc12_source_state source = {
+		.online = true,
+		.usb_type = POWER_SUPPLY_USB_TYPE_SDP,
+		.current_max = 500000,
+	};
+
+	KUNIT_EXPECT_TRUE(test, ci_msm_bc12_source_stop(&source, true, true));
+	KUNIT_EXPECT_TRUE(test, source.online);
+	KUNIT_EXPECT_EQ(test, source.usb_type, POWER_SUPPLY_USB_TYPE_SDP);
+	KUNIT_EXPECT_EQ(test, source.current_max, 100000);
+	KUNIT_EXPECT_FALSE(test, ci_msm_bc12_source_stop(&source, true, true));
+}
+
+static void bc12_test_stop_clears_disconnected_source(struct kunit *test)
+{
+	struct ci_msm_bc12_source_state source = {
+		.online = true,
+		.usb_type = POWER_SUPPLY_USB_TYPE_DCP,
+		.current_max = 1200000,
+	};
+
+	KUNIT_EXPECT_TRUE(test, ci_msm_bc12_source_stop(&source, false, true));
+	KUNIT_EXPECT_FALSE(test, source.online);
+	KUNIT_EXPECT_EQ(test, source.usb_type, POWER_SUPPLY_USB_TYPE_UNKNOWN);
+	KUNIT_EXPECT_EQ(test, source.current_max, 0);
+
+	source.online = true;
+	source.usb_type = POWER_SUPPLY_USB_TYPE_CDP;
+	source.current_max = 1200000;
+	KUNIT_EXPECT_TRUE(test, ci_msm_bc12_source_stop(&source, true, false));
+	KUNIT_EXPECT_FALSE(test, source.online);
+	KUNIT_EXPECT_EQ(test, source.current_max, 0);
+}
+
+static void bc12_test_disconnected_during_detection(struct kunit *test)
+{
+	struct ci_msm_bc12_source_state source = {
+		.online = true,
+		.usb_type = POWER_SUPPLY_USB_TYPE_DCP,
+		.current_max = 1200000,
+	};
+
+	KUNIT_EXPECT_TRUE(test, ci_msm_bc12_source_complete(&source, false,
+						    CI_MSM_BC12_DCP));
+	KUNIT_EXPECT_FALSE(test, source.online);
+	KUNIT_EXPECT_EQ(test, source.usb_type, POWER_SUPPLY_USB_TYPE_UNKNOWN);
+	KUNIT_EXPECT_EQ(test, source.current_max, 0);
+
+	KUNIT_EXPECT_TRUE(test, ci_msm_bc12_source_complete(&source, true,
+						    CI_MSM_BC12_UNKNOWN));
+	KUNIT_EXPECT_TRUE(test, source.online);
+	KUNIT_EXPECT_EQ(test, source.current_max, 100000);
+	KUNIT_EXPECT_TRUE(test, ci_msm_bc12_source_complete(&source, true,
+						    CI_MSM_BC12_DCP));
+	KUNIT_EXPECT_EQ(test, source.usb_type, POWER_SUPPLY_USB_TYPE_DCP);
+	KUNIT_EXPECT_EQ(test, source.current_max, 1200000);
+}
+
+static void bc12_test_unbound_source_detection_needed(struct kunit *test)
+{
+	struct ci_msm_bc12_source_state source = {
+		.online = true,
+		.usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN,
+		.current_max = 100000,
+	};
+
+	KUNIT_EXPECT_TRUE(test,
+		ci_msm_bc12_source_needs_detection(&source, true, true));
+	KUNIT_EXPECT_FALSE(test,
+		ci_msm_bc12_source_needs_detection(&source, false, true));
+	KUNIT_EXPECT_FALSE(test,
+		ci_msm_bc12_source_needs_detection(&source, true, false));
+
+	source.usb_type = POWER_SUPPLY_USB_TYPE_SDP;
+	KUNIT_EXPECT_FALSE(test,
+		ci_msm_bc12_source_needs_detection(&source, true, true));
+	source.usb_type = POWER_SUPPLY_USB_TYPE_DCP;
+	source.current_max = 1200000;
+	KUNIT_EXPECT_FALSE(test,
+		ci_msm_bc12_source_needs_detection(&source, true, true));
+	source.usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	KUNIT_EXPECT_FALSE(test,
+		ci_msm_bc12_source_needs_detection(&source, true, true));
+	source.online = false;
+	KUNIT_EXPECT_TRUE(test,
+		ci_msm_bc12_source_needs_detection(&source, true, true));
+}
+
+static struct kunit_case bc12_test_cases[] = {
+	KUNIT_CASE(bc12_test_classification),
+	KUNIT_CASE(bc12_test_error_restores_phy),
+	KUNIT_CASE(bc12_test_rebind_after_phy_reset),
+	KUNIT_CASE(bc12_test_gadget_stop_keeps_live_source),
+	KUNIT_CASE(bc12_test_sdp_budget_drops_after_unbind),
+	KUNIT_CASE(bc12_test_stop_clears_disconnected_source),
+	KUNIT_CASE(bc12_test_disconnected_during_detection),
+	KUNIT_CASE(bc12_test_unbound_source_detection_needed),
+	{}
+};
+
+static struct kunit_suite bc12_test_suite = {
+	.name = "ci-msm-bc12",
+	.test_cases = bc12_test_cases,
+};
+
+kunit_test_suite(bc12_test_suite);
diff --git a/drivers/usb/chipidea/ci_hdrc_msm_glue.c b/drivers/usb/chipidea/ci_hdrc_msm_glue.c
new file mode 100644
index 000000000..1222f2371
--- /dev/null
+++ b/drivers/usb/chipidea/ci_hdrc_msm_glue.c
@@ -0,0 +1,672 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright (c) 2010, Code Aurora Forum. All rights reserved. */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/usb/chipidea.h>
+#include <linux/clk.h>
+#include <linux/reset.h>
+#include <linux/mfd/syscon.h>
+#include <linux/regmap.h>
+#include <linux/io.h>
+#include <linux/reset-controller.h>
+#include <linux/extcon.h>
+#include <linux/of.h>
+#include <linux/delay.h>
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12)
+#include <linux/power_supply.h>
+#include <linux/ulpi/driver.h>
+#endif
+
+#include "ci.h"
+#include "bits.h"
+#include "otg.h"
+#include "otg_fsm.h"
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12)
+#include "ci_hdrc_msm_bc12.h"
+#endif
+
+#define HS_PHY_AHB_MODE			0x0098
+
+#define HS_PHY_GENCONFIG		0x009c
+#define HS_PHY_TXFIFO_IDLE_FORCE_DIS	BIT(4)
+
+#define HS_PHY_GENCONFIG_2		0x00a0
+#define HS_PHY_SESS_VLD_CTRL_EN		BIT(7)
+#define HS_PHY_ULPI_TX_PKT_EN_CLR_FIX	BIT(19)
+
+#define HSPHY_SESS_VLD_CTRL		BIT(25)
+
+/* Vendor base starts at 0x200 beyond CI base */
+#define HS_PHY_CTRL			0x0040
+#define HS_PHY_SEC_CTRL			0x0078
+#define HS_PHY_DIG_CLAMP_N		BIT(16)
+#define HS_PHY_POR_ASSERT		BIT(0)
+
+struct ci_hdrc_msm {
+	struct platform_device *ci;
+	struct clk *core_clk;
+	struct clk *iface_clk;
+	struct clk *fs_clk;
+	struct ci_hdrc_platform_data pdata;
+	struct reset_controller_dev rcdev;
+	bool secondary_phy;
+	bool hsic;
+	bool gadget_phy_on;
+	void __iomem *base;
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12)
+	struct power_supply *source_psy;
+	struct power_supply_desc source_desc;
+	char *source_supplied_to;
+	/* Protect the source properties read from power_supply callbacks. */
+	spinlock_t source_lock;
+	struct ci_msm_bc12_source_state source;
+	struct work_struct source_work;
+	bool source_stopping;
+	unsigned int source_transition_depth;
+#endif
+};
+
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12)
+static enum power_supply_property ci_msm_source_properties[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_USB_TYPE,
+	POWER_SUPPLY_PROP_CURRENT_MAX,
+};
+
+static int ci_msm_source_get_property(struct power_supply *psy,
+				      enum power_supply_property property,
+				      union power_supply_propval *value)
+{
+	struct ci_hdrc_msm *msm_ci = power_supply_get_drvdata(psy);
+	unsigned long flags;
+
+	spin_lock_irqsave(&msm_ci->source_lock, flags);
+	switch (property) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		value->intval = msm_ci->source.online;
+		break;
+	case POWER_SUPPLY_PROP_USB_TYPE:
+		value->intval = msm_ci->source.usb_type;
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+		value->intval = msm_ci->source.current_max;
+		break;
+	default:
+		spin_unlock_irqrestore(&msm_ci->source_lock, flags);
+		return -EINVAL;
+	}
+	spin_unlock_irqrestore(&msm_ci->source_lock, flags);
+	return 0;
+}
+
+static void ci_msm_source_update(struct ci_hdrc_msm *msm_ci, bool online,
+				 enum ci_msm_bc12_type type)
+{
+	unsigned long flags;
+	bool changed;
+
+	if (!msm_ci->source_psy)
+		return;
+
+	spin_lock_irqsave(&msm_ci->source_lock, flags);
+	changed = ci_msm_bc12_source_complete(&msm_ci->source, online, type);
+	spin_unlock_irqrestore(&msm_ci->source_lock, flags);
+	if (changed)
+		power_supply_changed(msm_ci->source_psy);
+}
+
+static void ci_msm_source_stop(struct ci_hdrc_msm *msm_ci,
+			       bool vbus_active, bool gadget_role)
+{
+	unsigned long flags;
+	bool changed;
+
+	if (!msm_ci->source_psy)
+		return;
+	spin_lock_irqsave(&msm_ci->source_lock, flags);
+	changed = ci_msm_bc12_source_stop(&msm_ci->source, vbus_active,
+					   gadget_role);
+	spin_unlock_irqrestore(&msm_ci->source_lock, flags);
+	if (changed)
+		power_supply_changed(msm_ci->source_psy);
+}
+
+static int ci_msm_source_set_vbus_draw(struct ci_hdrc *ci, unsigned int milliamp)
+{
+	struct ci_hdrc_msm *msm_ci = dev_get_drvdata(ci->dev->parent);
+	unsigned long flags;
+	int current_max;
+
+	if (!msm_ci->source_psy)
+		return -EOPNOTSUPP;
+
+	current_max = min(milliamp, 500U) * 1000;
+	spin_lock_irqsave(&msm_ci->source_lock, flags);
+	if (!msm_ci->source.online ||
+	    msm_ci->source.usb_type != POWER_SUPPLY_USB_TYPE_SDP) {
+		spin_unlock_irqrestore(&msm_ci->source_lock, flags);
+		return 0;
+	}
+	msm_ci->source.current_max = current_max;
+	spin_unlock_irqrestore(&msm_ci->source_lock, flags);
+	power_supply_changed(msm_ci->source_psy);
+	return 0;
+}
+
+static int ci_msm_bc12_ulpi_read(void *context, u8 address)
+{
+	struct ci_hdrc *ci = context;
+
+	return ulpi_read(ci->ulpi, address);
+}
+
+static int ci_msm_bc12_ulpi_write(void *context, u8 address, u8 value)
+{
+	struct ci_hdrc *ci = context;
+
+	return ulpi_write(ci->ulpi, address, value);
+}
+
+static int ci_msm_bc12_line_state(void *context)
+{
+	struct ci_hdrc *ci = context;
+
+	return hw_read(ci, OP_PORTSC, GENMASK(11, 10));
+}
+
+static void ci_msm_bc12_wait(void *context, unsigned int milliseconds)
+{
+	msleep(milliseconds);
+}
+
+static void ci_msm_source_detect(struct ci_hdrc_msm *msm_ci,
+				 struct ci_hdrc *ci)
+{
+	const struct ci_msm_bc12_io io = {
+		.context = ci,
+		.read = ci_msm_bc12_ulpi_read,
+		.write = ci_msm_bc12_ulpi_write,
+		.line_state = ci_msm_bc12_line_state,
+		.wait_ms = ci_msm_bc12_wait,
+	};
+	enum ci_msm_bc12_type type = CI_MSM_BC12_UNKNOWN;
+	int ret;
+
+	if (!msm_ci->source_psy || !ci->ulpi ||
+	    ci->role != CI_ROLE_GADGET || !ci->vbus_active)
+		return;
+
+	ret = ci_msm_bc12_detect(&io, &type);
+	if (ret)
+		dev_warn(ci->dev, "USB source detection failed: %d\n", ret);
+	/* VBUS may have disappeared during the PHY's detection delays. */
+	ci_msm_source_update(msm_ci, ci->vbus_active &&
+			     !!hw_read_otgsc(ci, OTGSC_BSV), type);
+}
+
+static void ci_msm_source_work(struct work_struct *work)
+{
+	struct ci_hdrc_msm *msm_ci = container_of(work, struct ci_hdrc_msm,
+						  source_work);
+	struct platform_device *child = READ_ONCE(msm_ci->ci);
+	struct ci_hdrc *ci = child ? platform_get_drvdata(child) : NULL;
+	unsigned long flags;
+	u32 otg_irq_enable;
+	bool detect, gadget_id, vbus;
+	int ret;
+
+	if (!ci || !ci_otg_is_fsm_mode(ci))
+		return;
+
+	ret = pm_runtime_resume_and_get(ci->dev->parent);
+	if (ret < 0)
+		return;
+
+	/* The OTG state machine shares ci->wq; gadget stop drains this work. */
+	vbus = ci->vbus_active && !!hw_read_otgsc(ci, OTGSC_BSV);
+	gadget_id = !!hw_read_otgsc(ci, OTGSC_ID);
+	spin_lock_irqsave(&msm_ci->source_lock, flags);
+	detect = !msm_ci->source_stopping && !msm_ci->source_transition_depth &&
+		 ci_msm_bc12_source_needs_detection(&msm_ci->source, vbus,
+				    ci->role == CI_ROLE_GADGET && gadget_id);
+	spin_unlock_irqrestore(&msm_ci->source_lock, flags);
+	if (!vbus || !gadget_id || ci->role != CI_ROLE_GADGET) {
+		ci_msm_source_update(msm_ci, false, CI_MSM_BC12_UNKNOWN);
+		goto out;
+	}
+	if (!detect || READ_ONCE(ci->driver) ||
+	    READ_ONCE(ci->gadget_pm_active) ||
+	    !ci->ulpi || !ci->phy)
+		goto out;
+
+	/* Reset and power up the PHY exactly as the bound gadget does. */
+	disable_irq(ci->irq);
+	otg_irq_enable = hw_read_otgsc(ci, OTGSC_INT_EN_BITS);
+	ret = hw_device_reset(ci);
+	if (ret) {
+		dev_warn(ci->dev, "USB source controller reset failed: %d\n",
+			 ret);
+		ci_msm_source_update(msm_ci, true, CI_MSM_BC12_UNKNOWN);
+	}
+	ci->platdata->notify_event(ci, CI_HDRC_CONTROLLER_STOPPED_EVENT);
+	hw_write_otgsc(ci, OTGSC_INT_EN_BITS, otg_irq_enable);
+	ci_otg_fsm_reconcile_inputs(ci);
+	if (!hw_read_otgsc(ci, OTGSC_BSV) ||
+	    !hw_read_otgsc(ci, OTGSC_ID))
+		ci_msm_source_update(msm_ci, false, CI_MSM_BC12_UNKNOWN);
+	enable_irq(ci->irq);
+out:
+	pm_runtime_put(ci->dev->parent);
+}
+
+static void ci_msm_source_queue(struct ci_hdrc_msm *msm_ci,
+				struct ci_hdrc *ci)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&msm_ci->source_lock, flags);
+	if (!msm_ci->source_stopping && !msm_ci->source_transition_depth &&
+	    READ_ONCE(msm_ci->ci) && ci_otg_is_fsm_mode(ci) && ci->wq)
+		queue_work(ci->wq, &msm_ci->source_work);
+	spin_unlock_irqrestore(&msm_ci->source_lock, flags);
+}
+
+static int ci_msm_source_register(struct platform_device *pdev,
+				  struct ci_hdrc_msm *msm_ci,
+				  struct device_node *phy_node)
+{
+	struct power_supply_config config = {
+		.drv_data = msm_ci,
+		.fwnode = dev_fwnode(&pdev->dev),
+	};
+	struct power_supply *psy;
+	const char *name;
+
+	if (!of_device_is_compatible(phy_node, "qcom,usb-hs-phy-apq8064"))
+		return 0;
+
+	spin_lock_init(&msm_ci->source_lock);
+	INIT_WORK(&msm_ci->source_work, ci_msm_source_work);
+	msm_ci->source.usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	name = devm_kasprintf(&pdev->dev, GFP_KERNEL, "%s-source", dev_name(&pdev->dev));
+	if (!name)
+		return -ENOMEM;
+	msm_ci->source_desc.name = name;
+	msm_ci->source_desc.type = POWER_SUPPLY_TYPE_USB;
+	msm_ci->source_desc.properties = ci_msm_source_properties;
+	msm_ci->source_desc.num_properties = ARRAY_SIZE(ci_msm_source_properties);
+	msm_ci->source_desc.get_property = ci_msm_source_get_property;
+	msm_ci->source_desc.usb_types = BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN) |
+		BIT(POWER_SUPPLY_USB_TYPE_SDP) |
+		BIT(POWER_SUPPLY_USB_TYPE_CDP) |
+		BIT(POWER_SUPPLY_USB_TYPE_DCP);
+
+	if (!device_property_read_string(&pdev->dev, "qcom,bc12-supplied-to",
+					 &name)) {
+		msm_ci->source_supplied_to = devm_kstrdup(&pdev->dev, name,
+							 GFP_KERNEL);
+		if (!msm_ci->source_supplied_to)
+			return -ENOMEM;
+		config.supplied_to = &msm_ci->source_supplied_to;
+		config.num_supplicants = 1;
+	}
+
+	psy = devm_power_supply_register(&pdev->dev, &msm_ci->source_desc,
+					 &config);
+	if (IS_ERR(psy))
+		return PTR_ERR(psy);
+	msm_ci->source_psy = psy;
+	return 0;
+}
+#endif
+
+static int
+ci_hdrc_msm_por_reset(struct reset_controller_dev *r, unsigned long id)
+{
+	struct ci_hdrc_msm *ci_msm = container_of(r, struct ci_hdrc_msm, rcdev);
+	void __iomem *addr = ci_msm->base;
+	u32 val;
+
+	if (id)
+		addr += HS_PHY_SEC_CTRL;
+	else
+		addr += HS_PHY_CTRL;
+
+	val = readl_relaxed(addr);
+	val |= HS_PHY_POR_ASSERT;
+	writel(val, addr);
+	/*
+	 * wait for minimum 10 microseconds as suggested by manual.
+	 * Use a slightly larger value since the exact value didn't
+	 * work 100% of the time.
+	 */
+	udelay(12);
+	val &= ~HS_PHY_POR_ASSERT;
+	writel(val, addr);
+
+	return 0;
+}
+
+static const struct reset_control_ops ci_hdrc_msm_reset_ops = {
+	.reset = ci_hdrc_msm_por_reset,
+};
+
+static int ci_hdrc_msm_notify_event(struct ci_hdrc *ci, unsigned event)
+{
+	struct device *dev = ci->dev->parent;
+	struct ci_hdrc_msm *msm_ci = dev_get_drvdata(dev);
+	int ret;
+
+	switch (event) {
+	case CI_HDRC_CONTROLLER_RESET_EVENT:
+		dev_dbg(dev, "CI_HDRC_CONTROLLER_RESET_EVENT received\n");
+
+		hw_phymode_configure(ci);
+		if (msm_ci->secondary_phy) {
+			u32 val = readl_relaxed(msm_ci->base + HS_PHY_SEC_CTRL);
+			val |= HS_PHY_DIG_CLAMP_N;
+			writel_relaxed(val, msm_ci->base + HS_PHY_SEC_CTRL);
+		}
+
+		ret = phy_init(ci->phy);
+		if (ret)
+			return ret;
+
+		ret = phy_power_on(ci->phy);
+		if (ret) {
+			phy_exit(ci->phy);
+			return ret;
+		}
+		msm_ci->gadget_phy_on = true;
+
+		/* use AHB transactor, allow posted data writes */
+		hw_write_id_reg(ci, HS_PHY_AHB_MODE, 0xffffffff, 0x8);
+
+		/* workaround for rx buffer collision issue */
+		hw_write_id_reg(ci, HS_PHY_GENCONFIG,
+				HS_PHY_TXFIFO_IDLE_FORCE_DIS, 0);
+
+		if (!msm_ci->hsic)
+			hw_write_id_reg(ci, HS_PHY_GENCONFIG_2,
+					HS_PHY_ULPI_TX_PKT_EN_CLR_FIX, 0);
+
+		if (!IS_ERR(ci->platdata->vbus_extcon.edev) || ci->role_switch) {
+			hw_write_id_reg(ci, HS_PHY_GENCONFIG_2,
+					HS_PHY_SESS_VLD_CTRL_EN,
+					HS_PHY_SESS_VLD_CTRL_EN);
+			hw_write(ci, OP_USBCMD, HSPHY_SESS_VLD_CTRL,
+				 HSPHY_SESS_VLD_CTRL);
+
+		}
+		/* USB PHY is now powered; the gadget has not joined the bus yet. */
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12)
+		ci_msm_source_detect(msm_ci, ci);
+#endif
+		break;
+	case CI_HDRC_CONTROLLER_VBUS_EVENT:
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12)
+		ci_msm_source_update(msm_ci, ci->vbus_active,
+				     CI_MSM_BC12_UNKNOWN);
+		if (!ci->driver)
+			ci_msm_source_queue(msm_ci, ci);
+#endif
+		break;
+	case CI_HDRC_CONTROLLER_TRANSITION_START_EVENT:
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12)
+		if (msm_ci->source_psy) {
+			unsigned long flags;
+
+			spin_lock_irqsave(&msm_ci->source_lock, flags);
+			msm_ci->source_transition_depth++;
+			spin_unlock_irqrestore(&msm_ci->source_lock, flags);
+			cancel_work_sync(&msm_ci->source_work);
+		}
+#endif
+		break;
+	case CI_HDRC_CONTROLLER_TRANSITION_END_EVENT:
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12)
+		if (msm_ci->source_psy) {
+			unsigned long flags;
+			bool ready;
+
+			spin_lock_irqsave(&msm_ci->source_lock, flags);
+			if (WARN_ON_ONCE(!msm_ci->source_transition_depth)) {
+				spin_unlock_irqrestore(&msm_ci->source_lock, flags);
+				break;
+			}
+			ready = !--msm_ci->source_transition_depth;
+			spin_unlock_irqrestore(&msm_ci->source_lock, flags);
+			if (!ready)
+				break;
+			if (ci->role != CI_ROLE_GADGET || !ci->vbus_active ||
+			    !hw_read_otgsc(ci, OTGSC_BSV))
+				ci_msm_source_update(msm_ci, false,
+						     CI_MSM_BC12_UNKNOWN);
+			else {
+				ci_msm_source_stop(msm_ci, true, true);
+				ci_msm_source_queue(msm_ci, ci);
+			}
+		}
+#endif
+		break;
+	case CI_HDRC_CONTROLLER_STOPPED_EVENT:
+		dev_dbg(dev, "CI_HDRC_CONTROLLER_STOPPED_EVENT received\n");
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12)
+		ci_msm_source_stop(msm_ci, ci->vbus_active,
+				   ci->role == CI_ROLE_GADGET);
+#endif
+		if (msm_ci->gadget_phy_on) {
+			msm_ci->gadget_phy_on = false;
+			phy_power_off(ci->phy);
+			phy_exit(ci->phy);
+		}
+		break;
+	default:
+		dev_dbg(dev, "unknown ci_hdrc event\n");
+		break;
+	}
+
+	return 0;
+}
+
+static int ci_hdrc_msm_mux_phy(struct ci_hdrc_msm *ci,
+			       struct platform_device *pdev)
+{
+	struct regmap *regmap;
+	struct device *dev = &pdev->dev;
+	struct of_phandle_args args;
+	u32 val;
+	int ret;
+
+	ret = of_parse_phandle_with_fixed_args(dev->of_node, "phy-select", 2, 0,
+					       &args);
+	if (ret)
+		return 0;
+
+	regmap = syscon_node_to_regmap(args.np);
+	of_node_put(args.np);
+	if (IS_ERR(regmap))
+		return PTR_ERR(regmap);
+
+	ret = regmap_write(regmap, args.args[0], args.args[1]);
+	if (ret)
+		return ret;
+
+	ci->secondary_phy = !!args.args[1];
+	if (ci->secondary_phy) {
+		val = readl_relaxed(ci->base + HS_PHY_SEC_CTRL);
+		val |= HS_PHY_DIG_CLAMP_N;
+		writel_relaxed(val, ci->base + HS_PHY_SEC_CTRL);
+	}
+
+	return 0;
+}
+
+static int ci_hdrc_msm_probe(struct platform_device *pdev)
+{
+	struct ci_hdrc_msm *ci;
+	struct platform_device *plat_ci;
+	struct clk *clk;
+	struct reset_control *reset;
+	int ret;
+	struct device_node *ulpi_node, *phy_node;
+
+	dev_dbg(&pdev->dev, "ci_hdrc_msm_probe\n");
+
+	ci = devm_kzalloc(&pdev->dev, sizeof(*ci), GFP_KERNEL);
+	if (!ci)
+		return -ENOMEM;
+	platform_set_drvdata(pdev, ci);
+
+	ci->pdata.name = "ci_hdrc_msm";
+	ci->pdata.capoffset = DEF_CAPOFFSET;
+	ci->pdata.flags	= CI_HDRC_REGS_SHARED | CI_HDRC_DISABLE_STREAMING |
+			  CI_HDRC_OVERRIDE_AHB_BURST |
+			  CI_HDRC_OVERRIDE_PHY_CONTROL;
+	ci->pdata.notify_event = ci_hdrc_msm_notify_event;
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12)
+	ci->pdata.set_vbus_draw = ci_msm_source_set_vbus_draw;
+#endif
+
+	reset = devm_reset_control_get(&pdev->dev, "core");
+	if (IS_ERR(reset))
+		return PTR_ERR(reset);
+
+	ci->core_clk = clk = devm_clk_get(&pdev->dev, "core");
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
+	ci->iface_clk = clk = devm_clk_get(&pdev->dev, "iface");
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
+	ci->fs_clk = clk = devm_clk_get_optional(&pdev->dev, "fs");
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+
+	ci->base = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(ci->base))
+		return PTR_ERR(ci->base);
+
+	ci->rcdev.owner = THIS_MODULE;
+	ci->rcdev.ops = &ci_hdrc_msm_reset_ops;
+	ci->rcdev.of_node = pdev->dev.of_node;
+	ci->rcdev.nr_resets = 2;
+	ret = devm_reset_controller_register(&pdev->dev, &ci->rcdev);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(ci->fs_clk);
+	if (ret)
+		return ret;
+
+	reset_control_assert(reset);
+	usleep_range(10000, 12000);
+	reset_control_deassert(reset);
+
+	clk_disable_unprepare(ci->fs_clk);
+
+	ret = clk_prepare_enable(ci->core_clk);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(ci->iface_clk);
+	if (ret)
+		goto err_iface;
+
+	ret = ci_hdrc_msm_mux_phy(ci, pdev);
+	if (ret)
+		goto err_mux;
+
+	ulpi_node = of_get_child_by_name(pdev->dev.of_node, "ulpi");
+	if (ulpi_node) {
+		phy_node = of_get_next_available_child(ulpi_node, NULL);
+		ci->hsic = of_device_is_compatible(phy_node, "qcom,usb-hsic-phy");
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12)
+		ret = ci_msm_source_register(pdev, ci, phy_node);
+		if (ret) {
+			of_node_put(phy_node);
+			of_node_put(ulpi_node);
+			goto err_mux;
+		}
+		if (ci->source_psy)
+			ci->pdata.flags |= CI_HDRC_REPORT_VBUS_WITHOUT_GADGET;
+#endif
+		of_node_put(phy_node);
+	}
+	of_node_put(ulpi_node);
+
+	plat_ci = ci_hdrc_add_device(&pdev->dev, pdev->resource,
+				     pdev->num_resources, &ci->pdata);
+	if (IS_ERR(plat_ci)) {
+		ret = PTR_ERR(plat_ci);
+		if (ret != -EPROBE_DEFER)
+			dev_err(&pdev->dev, "ci_hdrc_add_device failed!\n");
+		goto err_mux;
+	}
+
+	pm_runtime_set_active(&pdev->dev);
+	pm_runtime_no_callbacks(&pdev->dev);
+	pm_runtime_enable(&pdev->dev);
+	WRITE_ONCE(ci->ci, plat_ci);
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12)
+	if (ci->source_psy) {
+		struct ci_hdrc *child = platform_get_drvdata(plat_ci);
+
+		if (child)
+			ci_msm_source_queue(ci, child);
+	}
+#endif
+
+	return 0;
+
+err_mux:
+	clk_disable_unprepare(ci->iface_clk);
+err_iface:
+	clk_disable_unprepare(ci->core_clk);
+	return ret;
+}
+
+static void ci_hdrc_msm_remove(struct platform_device *pdev)
+{
+	struct ci_hdrc_msm *ci = platform_get_drvdata(pdev);
+
+#if IS_ENABLED(CONFIG_USB_CHIPIDEA_MSM_BC12)
+	if (ci->source_psy) {
+		unsigned long flags;
+
+		spin_lock_irqsave(&ci->source_lock, flags);
+		ci->source_stopping = true;
+		spin_unlock_irqrestore(&ci->source_lock, flags);
+		cancel_work_sync(&ci->source_work);
+	}
+#endif
+	pm_runtime_disable(&pdev->dev);
+	ci_hdrc_remove_device(ci->ci);
+	clk_disable_unprepare(ci->iface_clk);
+	clk_disable_unprepare(ci->core_clk);
+}
+
+static const struct of_device_id msm_ci_dt_match[] = {
+	{ .compatible = "qcom,ci-hdrc", },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, msm_ci_dt_match);
+
+static struct platform_driver ci_hdrc_msm_driver = {
+	.probe = ci_hdrc_msm_probe,
+	.remove = ci_hdrc_msm_remove,
+	.driver = {
+		.name = "msm_hsusb",
+		.of_match_table = msm_ci_dt_match,
+	},
+};
+
+module_platform_driver(ci_hdrc_msm_driver);
+
+MODULE_ALIAS("platform:msm_hsusb");
+MODULE_ALIAS("platform:ci13xxx_msm");
+MODULE_DESCRIPTION("ChipIdea Highspeed Dual Role Controller");
+MODULE_LICENSE("GPL v2");
