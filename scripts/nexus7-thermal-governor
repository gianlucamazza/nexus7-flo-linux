#!/bin/sh
# Nexus 7 (flo): bring the CPU rails down from the 1.3 V boot level and cap
# the CPU frequency by temperature until the kernel has cooling maps.
set -u
CF=/sys/devices/system/cpu/cpufreq
FREQS=$(tr ' ' '\n' < $CF/policy0/scaling_available_frequencies | grep . | sort -n)
N=$(echo "$FREQS" | wc -l)
MIN_IDX=3           # never cap below the third OPP (594 MHz)
idx=$N
nth() { echo "$FREQS" | sed -n "${1}p"; }
maxtemp() { m=0; for z in /sys/class/thermal/thermal_zone*/; do
    case "$(cat "$z/type")" in cpu*-thermal) v=$(cat "$z/temp" 2>/dev/null || echo 0); [ "$v" -gt "$m" ] && m=$v;; esac
  done; echo "$m"; }
apply() { f=$(nth "$1"); for p in $CF/policy*; do echo "$f" > "$p/scaling_max_freq" 2>/dev/null; done; }

# Cores that are already at the lowest OPP keep the boot voltage until their
# first frequency change, so force one transition per policy.
lo=$(nth 1); next=$(nth 2)
for p in $CF/policy*; do
    echo userspace > "$p/scaling_governor"
    echo "$next" > "$p/scaling_setspeed"
    echo "$lo" > "$p/scaling_setspeed"
done
idx=$((N - 3)); apply "$idx"          # start below the top until temperature is known
for p in $CF/policy*; do echo schedutil > "$p/scaling_governor"; done


while :; do
    t=$(maxtemp)
    if   [ "$t" -ge 92000 ]; then idx=$((idx - 3))
    elif [ "$t" -ge 85000 ]; then idx=$((idx - 1))
    elif [ "$t" -le 72000 ]; then idx=$((idx + 1))
    fi
    [ "$idx" -lt "$MIN_IDX" ] && idx=$MIN_IDX
    [ "$idx" -gt "$N" ] && idx=$N
    apply "$idx"
    sleep 2
done
