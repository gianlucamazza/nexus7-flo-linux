#!/bin/sh
# Performance probe for the Nexus 7 (runs on the tablet).
#   nexus7-perfprobe [seconds] [output]
# Every 0.5 s it records the display (msm), GPU and touch interrupt counters,
# CPU frequencies, temperatures, per-CPU busy time and per-process CPU time.
# The display interrupt is enabled on demand by DRM, so its rate while the
# screen animates approximates the presented frame rate.
dur=${1:-60}
out=${2:-/var/tmp/perfprobe-$(date +%H%M%S).txt}
end=$(( $(date +%s) + dur ))
: > "$out"
while [ "$(date +%s)" -lt "$end" ]; do
	{
		read -r up _ < /proc/uptime
		awk -v up="$up" '
			FILENAME=="/proc/interrupts" && ($NF=="msm" || $NF=="gpu-irq" || $NF=="ektf3624") {s=0; for(i=2;i<=5;i++) s+=$i; v[$NF]=s}
			FILENAME=="/proc/stat" && /^cpu / {c=$2+$3+$4+$7+$8 " " $5+$6}
			FILENAME ~ /scaling_cur_freq/ {f=f $1 ","}
			FILENAME ~ /thermal_zone/ {t=t $1 ","}
			END {printf "@T %s msm=%d gpu=%d touch=%d f=%s t=%s\n@C %s\n", up, v["msm"], v["gpu-irq"], v["ektf3624"], f, t, c}
		' /proc/interrupts /proc/stat /sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq /sys/class/thermal/thermal_zone[1-4]/temp
		cat /proc/[0-9]*/stat 2>/dev/null | sed 's/^/@P /'
	} >> "$out"
	sleep 0.5
done
echo "$out"
