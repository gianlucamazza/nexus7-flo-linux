#!/usr/bin/env bash
# Collect a diagnostic archive on the tablet and unpack it on the laptop.
#   scripts/flo-diag            -> ~/nexus7-recovery-20261114/diag/<timestamp>/
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PRIV="$HOME/nexus7-recovery-20261114"
SSH=(ssh -i "$PRIV/diagnostic-key" -o UserKnownHostsFile="$PRIV/known_hosts" -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=10)
HOST=${FLO_HOST:-root@<tablet-usb-address>}
scp -q "${SSH[@]:1}" "$ROOT/scripts/nexus7-diag-collect" "$HOST:/usr/local/sbin/"
remote=$("${SSH[@]}" "$HOST" nexus7-diag-collect | tail -1)
dest="$PRIV/diag/$(basename "$remote" .tar.gz)"
mkdir -p "$dest"
scp -q "${SSH[@]:1}" "$HOST:$remote" "$dest.tar.gz"
tar -C "$dest" -xzf "$dest.tar.gz"
"${SSH[@]}" "$HOST" "rm -f '$remote'"
echo "$dest"
ls "$dest"
grep -v "Kernel command line" "$dest/dmesg.txt" | grep -cE "cmd dma tx failed|hangcheck|lockup|Oops|BUG|gpu fault" | sed 's/^/kernel error lines: /'
